---
import BaseLayout from '../layouts/BaseLayout.astro';
import regionColors from '../../content/themes/region-colors.json';
import crossLinksFile from '../../content/themes/cross-links.json';
import { buildThemeMap } from '../lib/themes';
import type { RawThemeNode, RawThemesData } from '../lib/themes';

// One file per theme node (content/themes/nodes/*.json) so editors can add,
// rename, and re-nest themes as independent CMS entries — the tree shape
// comes entirely from each node's own `parent` field, not file order.
const nodeFiles = import.meta.glob<RawThemeNode>('../../content/themes/nodes/*.json', { eager: true, import: 'default' });
const themesRaw: RawThemesData = {
  regionColors,
  nodes: Object.values(nodeFiles),
  crossLinks: crossLinksFile.links,
};

const themeMap = buildThemeMap(themesRaw);
const regions = themeMap.nodes.filter((n) => n.level === 0);
---

<BaseLayout
  title="The Making Of"
  active="making-of"
  fullscreen
  description="A pannable, zoomable map of the themes behind the Polyphonic Archive podcast."
>
  <Fragment slot="header-extra">
    <div class="mk-header-controls">
      <button type="button" class="mk-btn" data-act="overview">Overview</button>
      <button type="button" class="mk-btn mk-btn-square" data-act="zoom-out" aria-label="Zoom out">−</button>
      <button type="button" class="mk-btn mk-btn-square" data-act="zoom-in" aria-label="Zoom in">+</button>
    </div>
  </Fragment>

  <!-- Runs during parsing, before the intro card below is painted. The map
       script is a bundled module and therefore deferred, so between first
       paint and that script running the intro would otherwise show
       unpositioned — full size at the top-left corner, over the masthead —
       which reads as a flash of stray content on the way into the page.
       Gating on a class set here (rather than defaulting .mk-intro to
       opacity:0) keeps the card visible when JS never arrives at all. -->
  <script is:inline>document.documentElement.classList.add('mk-js');</script>

  <div id="mk-viewport">
    <div id="mk-bg"></div>
    <svg id="mk-lines" xmlns="http://www.w3.org/2000/svg"></svg>
    <div id="mk-terr"></div>
    <div id="mk-nodes">
      <div id="mk-intro" class="mk-intro">
        <div class="mk-eyebrow mk-intro-eyebrow">Polyphonic Archive · the making-of</div>
        <div class="mk-intro-title">A map of the themes behind the podcast</div>
        <div class="mk-intro-body">
          Four regions grow from one centre —
          {
            regions.map((r, i) => (
              <>
                <span style={`color:${r.color};`}>{r.label}</span>
                {i < regions.length - 2 ? ', ' : i === regions.length - 2 ? ' and ' : ''}
              </>
            ))
          }
          . Themes light up as you move through them; wires show what belongs where, and each theme's reading panel surfaces what it connects across.
        </div>
        <div class="mk-eyebrow mk-intro-hint">drag to pan · scroll to zoom · press a theme to read</div>
        <button type="button" id="mk-intro-close" class="mk-intro-enter" aria-label="Enter the map">↓</button>
        <div class="mk-eyebrow mk-intro-foot">the map lies below ↓ · you can always drag your way back up here</div>
      </div>
    </div>
  </div>

  <button type="button" id="mk-to-intro" class="mk-pill" hidden>
    <span class="mk-pill-arrow">↑</span><span>Intro</span>
  </button>

  <div id="mk-nudge" class="mk-nudge" hidden>Press a lit theme to read more</div>

  <div id="mk-tooltip" class="mk-tooltip" hidden></div>

  <aside id="mk-panel" class="mk-panel" hidden>
    <div class="mk-panel-top">
      <div id="mk-breadcrumb" class="mk-breadcrumb"></div>
      <button type="button" class="mk-btn" data-act="close">Close ×</button>
    </div>
    <div id="mk-panel-hint" class="mk-panel-hint" hidden>The path above shows where you are — press a step to go back out, or a sub-theme below to go deeper.</div>
    <h2 id="mk-panel-title" class="mk-panel-title"></h2>
    <div id="mk-panel-authors" class="mk-panel-authors" hidden></div>
    <div id="mk-panel-rule" class="mk-panel-rule"></div>
    <div id="mk-panel-blocks" class="mk-panel-blocks"></div>
    <div id="mk-panel-questions" class="mk-panel-questions" hidden>
      <div class="mk-eyebrow mk-panel-label">Open questions</div>
      <div id="mk-panel-questions-list"></div>
    </div>
    <div id="mk-panel-children" class="mk-panel-children" hidden>
      <div class="mk-eyebrow mk-panel-label">Sub-themes</div>
      <div id="mk-panel-children-list"></div>
    </div>
    <div id="mk-panel-connections" class="mk-panel-connections" hidden>
      <div class="mk-eyebrow mk-panel-label mk-panel-label-teal">Connections</div>
      <div id="mk-panel-connections-list"></div>
    </div>
    <div id="mk-panel-parent" class="mk-panel-parent" hidden></div>
  </aside>

  <script
    type="application/json"
    id="mk-data"
    set:html={JSON.stringify({ nodes: themeMap.nodes, links: themeMap.links, regionColors: themeMap.regionColors, bbox: themeMap.bbox })}
  />
</BaseLayout>

<style>
  #mk-viewport {
    position: fixed;
    left: 0;
    right: 0;
    top: var(--mk-header-h, 72px);
    bottom: 0;
    overflow: hidden;
    background: #120f18;
    touch-action: none;
    cursor: grab;
  }

  #mk-viewport.is-dragging {
    cursor: grabbing;
  }

  /* A static backdrop, kept to two soft glows rather than four so there's
     less for the browser to recomposite behind the constantly-repositioned
     nodes/lines/territories on every repaint. */
  #mk-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      radial-gradient(ellipse 1100px 750px at 30% 28%, rgba(122, 152, 214, 0.07), transparent 68%),
      radial-gradient(ellipse 1100px 750px at 70% 78%, rgba(210, 130, 136, 0.07), transparent 68%);
  }

  #mk-lines {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 5;
  }

  #mk-terr {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
  }

  #mk-nodes {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 10;
  }

  :global(.mk-node) {
    position: absolute;
    left: 0;
    top: 0;
    box-sizing: border-box;
    cursor: pointer;
    text-align: center;
    font-family: 'Courier Prime', 'Courier New', monospace;
  }

  :global(.mk-node:hover .mk-node-title) {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  :global(.mk-node-title) {
    font-weight: 400;
    color: #f2eee6;
    line-height: 1.15;
  }

  :global(.mk-node-num) {
    font-family: 'Courier Prime', monospace;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  :global(.mk-node-sub) {
    letter-spacing: 0.05em;
    color: #9a938a;
  }

  :global(.mk-link) {
    fill: none;
    stroke-linecap: round;
    pointer-events: none;
  }

  :global(.mk-link-hit) {
    stroke: #000;
    stroke-opacity: 0;
    stroke-width: 16;
    pointer-events: stroke;
    cursor: default;
  }

  @keyframes mkpulse {
    0%,
    100% {
      box-shadow: 0 18px 44px rgba(0, 0, 0, 0.42), 0 0 0 0 rgba(244, 203, 122, 0);
    }
    50% {
      box-shadow: 0 18px 44px rgba(0, 0, 0, 0.42), 0 0 0 16px rgba(244, 203, 122, 0.17);
    }
  }

  :global(.mk-node.mk-pulse) {
    animation: mkpulse 2.4s ease-in-out infinite;
  }

  @keyframes mkfadein {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  :global(.mk-terr-label) {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    font-family: 'Courier Prime', monospace;
    font-weight: 700;
    letter-spacing: 0.1em;
    font-size: 118px;
  }

  .mk-tooltip {
    position: fixed;
    z-index: 60;
    pointer-events: none;
    max-width: 268px;
    background: #2a2632;
    border: 1px solid rgba(230, 225, 217, 0.3);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.2), 0 10px 28px rgba(0, 0, 0, 0.4);
    padding: 11px 14px;
    font-family: 'Courier Prime', monospace;
    font-size: 13px;
    line-height: 1.5;
    color: #e6e1d9;
  }

  .mk-tooltip[hidden] {
    display: none;
  }

  .mk-nudge {
    position: fixed;
    top: calc(var(--mk-header-h, 72px) + 28px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 41;
    pointer-events: none;
    font-family: 'Courier Prime', monospace;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: #48c6a8;
    animation: mkfadein 0.5s ease;
  }

  .mk-nudge[hidden] {
    display: none;
  }

  .mk-header-controls {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }

  .mk-btn {
    font-family: 'Courier Prime', monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
    line-height: 1;
    padding: 8px 13px;
    border: 1px solid rgba(230, 225, 217, 0.5);
    background: transparent;
    color: #e6e1d9;
    cursor: pointer;
  }

  .mk-btn:hover {
    border-color: #48c6a8;
    color: #48c6a8;
  }

  .mk-btn-square {
    font-size: 16px;
    width: 33px;
    height: 33px;
    padding: 0;
  }

  .mk-btn-sm {
    font-size: 11px;
    padding: 6px 10px;
  }

  .mk-pill {
    position: fixed;
    top: calc(var(--mk-header-h, 72px) + 18px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 40;
    font-family: 'Courier Prime', monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
    padding: 7px 12px;
    border: 1px solid rgba(230, 225, 217, 0.35);
    background: rgba(26, 23, 32, 0.85);
    color: #9a938a;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .mk-pill:hover {
    border-color: #f4cb7a;
    color: #f4cb7a;
  }

  .mk-pill[hidden] {
    display: none;
  }

  .mk-pill-arrow {
    font-size: 13px;
  }

  .mk-eyebrow {
    font-family: 'Courier Prime', monospace;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 400;
  }

  .mk-intro {
    position: absolute;
    left: 0;
    top: 0;
    width: 860px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 26px;
    text-align: center;
    z-index: 15;
    will-change: transform, opacity;
  }

  /* Hidden only until the camera's first applyCam() gives it a real
     transform and opacity — see the inline script above the viewport. */
  :global(html.mk-js) .mk-intro {
    opacity: 0;
  }

  .mk-intro-eyebrow {
    font-size: 13px;
    color: #f4cb7a;
  }

  .mk-intro-title {
    font-weight: 700;
    font-size: clamp(1.6rem, 4vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #f2eee6;
    max-width: 800px;
  }

  .mk-intro-body {
    font-size: 17px;
    line-height: 1.75;
    color: #b9b2a7;
    max-width: 600px;
  }

  .mk-intro-hint {
    font-size: 12px;
    color: #9a938a;
  }

  .mk-intro-enter {
    font-family: 'Courier Prime', monospace;
    margin-top: 6px;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    border: 1.5px solid #f4cb7a;
    background: transparent;
    color: #f4cb7a;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
  }

  .mk-intro-enter:hover {
    background: rgba(244, 203, 122, 0.14);
  }

  .mk-intro-foot {
    font-size: 11px;
    color: #655e55;
  }

  .mk-panel {
    position: fixed;
    top: var(--mk-header-h, 72px);
    right: 0;
    bottom: 0;
    width: min(452px, 42vw);
    z-index: 45;
    background: #262230;
    border-left: 1px solid rgba(230, 225, 217, 0.2);
    padding: 26px 28px 44px;
    overflow-y: auto;
    box-sizing: border-box;
    font-family: 'Courier Prime', monospace;
    color: #e6e1d9;
  }

  .mk-panel[hidden] {
    display: none;
  }

  .mk-panel-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .mk-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    row-gap: 5px;
    min-width: 0;
    padding-top: 4px;
    font-size: 11px;
  }

  :global(.mk-crumb) {
    display: inline-flex;
    align-items: baseline;
    cursor: pointer;
  }

  :global(.mk-crumb-label) {
    font-size: 11px;
    color: #9a938a;
  }

  :global(.mk-crumb-label:hover) {
    color: #48c6a8;
    text-decoration: underline;
  }

  :global(.mk-crumb-sep) {
    font-size: 11px;
    color: #655e55;
    padding: 0 6px;
  }

  .mk-panel-hint {
    font-size: 12.5px;
    line-height: 1.55;
    color: #f4cb7a;
    margin-top: 10px;
  }

  .mk-panel-hint[hidden] {
    display: none;
  }

  .mk-panel-title {
    font-weight: 700;
    font-size: 30px;
    line-height: 1.14;
    letter-spacing: -0.02em;
    margin: 13px 0 0;
    color: #f2eee6;
  }

  .mk-panel-authors {
    font-size: 12px;
    letter-spacing: 0.03em;
    color: #9a938a;
    margin-top: 12px;
  }

  .mk-panel-authors[hidden] {
    display: none;
  }

  .mk-panel-rule {
    height: 1px;
    opacity: 0.45;
    margin: 18px 0;
  }

  .mk-panel-blocks {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  :global(.mk-block-text) {
    font-size: 17px;
    line-height: 1.7;
    color: #e6e1d9;
  }

  :global(.mk-block-media) {
    border: 1px solid rgba(230, 225, 217, 0.16);
    background: rgba(0, 0, 0, 0.22);
  }

  :global(.mk-block-media img),
  :global(.mk-block-media video) {
    display: block;
    width: 100%;
    max-height: 360px;
    object-fit: cover;
  }

  :global(.mk-block-media audio) {
    display: block;
    width: 100%;
  }

  :global(.mk-block-media .mk-block-audio-wrap) {
    padding: 14px;
  }

  :global(.mk-block-caption) {
    font-size: 12px;
    font-style: italic;
    line-height: 1.5;
    color: #9a938a;
    padding: 8px 10px;
  }

  .mk-panel-label {
    font-size: 12px;
    color: #9a938a;
    margin: 26px 0 10px;
  }

  .mk-panel-label-teal {
    color: #48c6a8;
  }

  .mk-panel-questions[hidden],
  .mk-panel-children[hidden],
  .mk-panel-connections[hidden],
  .mk-panel-parent[hidden] {
    display: none;
  }

  :global(.mk-question) {
    font-style: italic;
    font-size: 16px;
    line-height: 1.5;
    color: #e6e1d9;
    border-left: 2px solid;
    padding-left: 14px;
    margin: 11px 0;
  }

  :global(.mk-child-row) {
    display: flex;
    gap: 10px;
    align-items: baseline;
    padding: 10px 0;
    border-bottom: 1px solid rgba(230, 225, 217, 0.12);
    cursor: pointer;
  }

  :global(.mk-child-num) {
    font-size: 12px;
    color: #9a938a;
    flex: none;
  }

  :global(.mk-child-label) {
    font-size: 16px;
    line-height: 1.3;
    color: #e6e1d9;
  }

  :global(.mk-child-row:hover .mk-child-label) {
    color: #48c6a8;
  }

  :global(.mk-conn) {
    border: 1px solid rgba(230, 225, 217, 0.3);
    padding: 12px 14px;
    margin-bottom: 10px;
    cursor: pointer;
    background: #211d27;
  }

  :global(.mk-conn-head) {
    display: flex;
    gap: 8px;
    align-items: baseline;
    flex-wrap: nowrap;
  }

  :global(.mk-conn-num) {
    font-size: 12px;
    color: #48c6a8;
    flex: none;
    white-space: nowrap;
  }

  :global(.mk-conn-label) {
    font-weight: 700;
    font-size: 16px;
    line-height: 1.3;
    color: #e6e1d9;
    flex: 1;
  }

  :global(.mk-conn-text) {
    font-size: 13px;
    line-height: 1.5;
    color: #9a938a;
    margin-top: 7px;
  }

  .mk-panel-parent {
    height: 1px;
    background: rgba(230, 225, 217, 0.12);
    margin: 22px 0 13px;
    padding-top: 13px;
    border-top: none;
  }

  :global(.mk-parent-link) {
    font-size: 13px;
    color: #9a938a;
    cursor: pointer;
  }

  :global(.mk-parent-link:hover) {
    color: #48c6a8;
  }

  @media (max-width: 780px) {
    .mk-panel {
      width: 100%;
    }
  }
</style>

<script>
  interface ContentBlock {
    type: 'text' | 'image' | 'audio' | 'video';
    text: string | null;
    file: string | null;
    caption: string | null;
  }
  interface ThemeNode {
    id: string;
    number: string;
    label: string;
    level: number;
    parent: string | null;
    blocks: ContentBlock[];
    questions: string[];
    authors: string | null;
    color: string;
    x: number;
    y: number;
    children: string[];
  }
  interface ThemeLink {
    from: string;
    to: string;
    note: string;
  }

  const DATA: { nodes: ThemeNode[]; links: ThemeLink[]; regionColors: Record<string, string>; bbox: any } = JSON.parse(
    document.getElementById('mk-data')!.textContent || '{}',
  );

  const byId: Record<string, ThemeNode> = {};
  DATA.nodes.forEach((n) => (byId[n.id] = n));
  const root = DATA.nodes.find((n) => n.level === -1)!;

  const LEVEL_CFG: Record<
    number,
    { width: number; font: number; border: number; blob: 'a' | 'b'; bg: string; shadow: string; padding: string }
  > = {
    [-1]: { width: 1400, font: 124, border: 4, blob: 'a', bg: 'rgba(40,36,48,0.82)', shadow: '0 18px 44px rgba(0,0,0,0.5)', padding: '46px 60px' },
    0: { width: 760, font: 84, border: 3.5, blob: 'a', bg: 'rgba(38,34,46,0.7)', shadow: '0 14px 32px rgba(0,0,0,0.46)', padding: '30px 36px' },
    1: { width: 440, font: 44, border: 2.5, blob: 'b', bg: 'rgba(34,30,42,0.66)', shadow: '0 9px 22px rgba(0,0,0,0.4)', padding: '18px 22px' },
    2: { width: 380, font: 36, border: 2.5, blob: 'a', bg: 'rgba(30,27,38,0.62)', shadow: '0 6px 15px rgba(0,0,0,0.36)', padding: '14px 18px' },
    3: { width: 330, font: 31, border: 2.5, blob: 'b', bg: 'rgba(26,23,33,0.58)', shadow: '0 4px 11px rgba(0,0,0,0.32)', padding: '12px 16px' },
  };
  const BLOB_A = '332px 20px 293px 20px / 20px 293px 20px 332px';
  const BLOB_B = '18px 306px 18px 319px / 306px 18px 319px 18px';

  const viewport = document.getElementById('mk-viewport')!;
  const linesSvg = document.getElementById('mk-lines') as unknown as SVGSVGElement;
  const terrLayer = document.getElementById('mk-terr')!;
  const nodesLayer = document.getElementById('mk-nodes')!;
  const panel = document.getElementById('mk-panel')!;
  const introEl = document.getElementById('mk-intro')!;
  const toIntroBtn = document.getElementById('mk-to-intro')!;
  const nudgeEl = document.getElementById('mk-nudge')!;
  const tooltipEl = document.getElementById('mk-tooltip')!;
  const panelHintEl = document.getElementById('mk-panel-hint')!;

  function hexA(hex: string, a: number) {
    const v = Math.max(0, Math.min(1, a));
    return hex.slice(0, 7) + Math.round(v * 255).toString(16).padStart(2, '0');
  }

  // --- Build node DOM. Position is driven entirely by the 3D camera every
  // frame (see applyCam below) — these elements carry no left/top of their
  // own, only their level-based size/shape/color. ---
  const nodeEls: Record<string, HTMLElement> = {};
  DATA.nodes.forEach((n) => {
    const cfg = LEVEL_CFG[n.level] || LEVEL_CFG[3];
    const el = document.createElement('div');
    el.className = `mk-node lvl-${n.level}`;
    el.dataset.id = n.id;
    el.style.width = `${cfg.width}px`;
    el.style.background = cfg.bg;
    el.style.border = `${cfg.border}px solid ${n.color}`;
    el.style.borderRadius = cfg.blob === 'a' ? BLOB_A : BLOB_B;
    el.style.padding = cfg.padding;
    el.style.boxShadow = cfg.shadow;

    const title = document.createElement('div');
    title.className = 'mk-node-title';
    title.style.fontSize = `${cfg.font}px`;
    title.style.fontWeight = n.level <= -1 ? '700' : '400';

    if (n.level >= 1) {
      const num = document.createElement('div');
      num.className = 'mk-node-num';
      num.style.fontSize = `${cfg.font * 0.44}px`;
      num.style.color = n.color;
      num.style.marginBottom = `${cfg.font * 0.18}px`;
      num.textContent = n.number;
      el.appendChild(num);
    }

    title.textContent = n.label;
    el.appendChild(title);

    if (n.children.length && n.level <= 1) {
      const sub = document.createElement('div');
      sub.className = 'mk-node-sub';
      sub.style.fontSize = `${cfg.font * 0.19}px`;
      sub.style.marginTop = `${cfg.font * 0.18}px`;
      sub.textContent = `${n.children.length} sub-theme${n.children.length > 1 ? 's' : ''} →`;
      el.appendChild(sub);
    }

    nodesLayer.appendChild(el);
    nodeEls[n.id] = el;
  });

  // --- Region territory labels: giant background text sized to each
  // region's own node cluster, its position computed from the auto-layout
  // (no hardcoded spots) by walking each node up to its level-0 ancestor. ---
  function topRegion(n: ThemeNode): ThemeNode | null {
    let cur: ThemeNode | undefined = n;
    while (cur && cur.level > 0) cur = cur.parent ? byId[cur.parent] : undefined;
    return cur && cur.level === 0 ? cur : null;
  }
  const regionGroups: Record<string, { label: string; color: string; sx: number; sy: number; n: number }> = {};
  DATA.nodes.forEach((n) => {
    const reg = topRegion(n);
    if (!reg) return;
    const g = (regionGroups[reg.id] ??= { label: reg.label, color: reg.color, sx: 0, sy: 0, n: 0 });
    g.sx += n.x;
    g.sy += n.y;
    g.n += 1;
  });
  const territories = Object.values(regionGroups).map((g) => {
    const el = document.createElement('div');
    el.className = 'mk-terr-label';
    el.style.color = g.color;
    el.textContent = g.label.toUpperCase();
    terrLayer.appendChild(el);
    return { el, x: g.sx / g.n, y: g.sy / g.n };
  });

  // --- Build SVG lines: hierarchy ("belongs to — sub-theme") wires only.
  // Cross-region relationships (content/themes/cross-links.json) stay fully
  // intact as data and surface as clickable cards in the reading panel's
  // "Connections" section — they're just not drawn as wires here. Each wire
  // is a slightly irregular, hand-drawn-looking thread (a few random knots
  // plus an SVG turbulence filter) that plucks when you select a theme and
  // drifts gently on its own now and then. ---
  const NS = 'http://www.w3.org/2000/svg';
  linesSvg.innerHTML = '';
  const defs = document.createElementNS(NS, 'defs');
  defs.innerHTML =
    '<filter id="mk-thread"><feTurbulence type="fractalNoise" baseFrequency="0.011 0.018" numOctaves="2" seed="7" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="3" xChannelSelector="R" yChannelSelector="G"/></filter>';
  linesSvg.appendChild(defs);
  const fxGroup = document.createElementNS(NS, 'g');
  fxGroup.setAttribute('filter', 'url(#mk-thread)');
  const haloLayer = document.createElementNS(NS, 'g');
  const coreLayer = document.createElementNS(NS, 'g');
  fxGroup.appendChild(haloLayer);
  fxGroup.appendChild(coreLayer);
  linesSvg.appendChild(fxGroup);
  const hitLayer = document.createElementNS(NS, 'g');
  linesSvg.appendChild(hitLayer);

  interface Knot {
    f: number;
    off: number;
  }
  interface LineRec {
    a: string;
    b: string;
    halo: SVGPathElement;
    vis: SVGPathElement;
    hit: SVGLineElement;
    knots: Knot[];
    freq: number;
    phase: number;
    ampBase: number;
    amp: number;
    t0: number;
    delay: number;
    dur: number;
    decay: number;
    hover: boolean;
  }
  const lines: LineRec[] = [];
  const adj: Record<string, string[]> = {};
  function addAdj(x: string, y: string) {
    (adj[x] ??= []).push(y);
    (adj[y] ??= []).push(x);
  }

  function addLine(a: ThemeNode, b: ThemeNode) {
    const halo = document.createElementNS(NS, 'path');
    halo.setAttribute('class', 'mk-link');
    halo.setAttribute('stroke', '#cbd2d4');
    const vis = document.createElementNS(NS, 'path');
    vis.setAttribute('class', 'mk-link');
    vis.setAttribute('stroke', '#ffffff');
    const hit = document.createElementNS(NS, 'line');
    hit.setAttribute('class', 'mk-link-hit');
    haloLayer.appendChild(halo);
    coreLayer.appendChild(vis);
    hitLayer.appendChild(hit);

    const wlen = Math.hypot(b.x - a.x, b.y - a.y);
    const nK = 3 + Math.floor(Math.random() * 2);
    const knots: Knot[] = [];
    for (let q = 1; q <= nK; q++) {
      let f = q / (nK + 1) + (Math.random() * 2 - 1) * 0.04;
      f = Math.max(0.06, Math.min(0.94, f));
      knots.push({ f, off: (Math.random() * 2 - 1) * 0.05 });
    }
    knots.sort((p, q2) => p.f - q2.f);

    const rec: LineRec = {
      a: a.id,
      b: b.id,
      halo,
      vis,
      hit,
      knots,
      freq: Math.max(1.0, Math.min(2.6, 820 / wlen)),
      phase: Math.random() * 6.283,
      ampBase: 0.045 + Math.random() * 0.025,
      amp: 0,
      t0: 0,
      delay: 0,
      dur: 3.4,
      decay: 1.45,
      hover: false,
    };
    hit.addEventListener('pointerenter', (ev) => {
      rec.hover = true;
      showTip(`${b.label} — sub-theme of ${a.label}`, ev as PointerEvent);
      renderStrings();
    });
    hit.addEventListener('pointermove', (ev) => moveTip(ev as PointerEvent));
    hit.addEventListener('pointerleave', () => {
      rec.hover = false;
      hideTip();
      renderStrings();
    });
    lines.push(rec);
  }

  DATA.nodes.forEach((n) => {
    if (n.parent && byId[n.parent]) addAdj(n.parent, n.id);
  });
  DATA.nodes.forEach((n) => {
    if (n.parent && byId[n.parent]) addLine(byId[n.parent], n);
  });

  // During pans/zooms/flights, drop the SVG displacement filter on the
  // threads (the most expensive repaint) and restore it once movement rests.
  let fxHeld = false;
  let motionTimer: number | undefined;
  function motion() {
    if (!fxHeld) {
      fxHeld = true;
      fxGroup.removeAttribute('filter');
    }
    window.clearTimeout(motionTimer);
    motionTimer = window.setTimeout(() => {
      fxHeld = false;
      fxGroup.setAttribute('filter', 'url(#mk-thread)');
    }, 180);
  }

  // --- Camera: a fake-3D perspective camera (F/dz projection) applied to
  // each node's auto-computed (x,y) plus a fixed z-depth per hierarchy
  // level — this is what gives the map its depth-of-field "fly through"
  // feel while still needing zero hand-placed coordinates. ---
  const F = 1300;
  const NEAR = 240;
  const ZLEVEL: Record<number, number> = { [-1]: 40, 0: 340, 1: 660, 2: 980, 3: 1300 };
  function zForLvl(l: number) {
    return ZLEVEL[l] ?? 0;
  }

  // The intro card lives at a world position above the map itself — the
  // camera starts there and "flies down" into the map on entry, and back up
  // again via the Intro pill or by pulling back past the overview edge.
  const INTRO = { x: root.x, y: root.y - 2980 };
  const INTRO_THRESHOLD = INTRO.y + 1060;

  const cam = { x: INTRO.x, y: INTRO.y, z: 0 };
  let refZ = zForLvl(0);
  let fitZ = zForLvl(0);
  let panelWidth = 0;
  let selId: string | null = null;
  let atIntro = true;
  let userMoved = false;
  let manualPan = false;
  let nudgeOn = true;
  let panelHintSeen = false;
  let panelHintShownThisSelection = false;
  try {
    panelHintSeen = !!localStorage.getItem('pa-mk-hint-panel');
  } catch (e) {}

  function vpSize() {
    return { w: viewport.clientWidth, h: viewport.clientHeight };
  }
  function centerXY() {
    const { w, h } = vpSize();
    return { cx: (w - panelWidth) / 2, cy: h / 2 };
  }

  function regionBBox() {
    let minx = Infinity;
    let miny = Infinity;
    let maxx = -Infinity;
    let maxy = -Infinity;
    DATA.nodes.forEach((n) => {
      if (n.level <= 0) {
        minx = Math.min(minx, n.x);
        miny = Math.min(miny, n.y);
        maxx = Math.max(maxx, n.x);
        maxy = Math.max(maxy, n.y);
      }
    });
    return { minx, miny, maxx, maxy };
  }

  function overviewDz() {
    const { w, h } = vpSize();
    if (!w || !h) return F * 6;
    const b = regionBBox();
    const pad = 460;
    const bw = b.maxx - b.minx + pad * 2;
    const bh = b.maxy - b.miny + pad * 2;
    let s = Math.min((w * 0.97) / bw, (h * 0.97) / bh);
    s = Math.max(0.1, Math.min(1.2, s));
    return F / s;
  }

  // --- Theatrical spotlight: which nodes are "lit" right now. With nothing
  // selected, deeper levels fade in smoothly as you zoom past the overview;
  // with a theme selected, its direct sub-themes stay fully lit, its
  // grandchildren and unrelated branches sink into shadow, and its
  // ancestors stay dimly visible for context. ---
  function focusMul(id: string): number {
    if (!selId) {
      const n0 = byId[id];
      if (!n0 || n0.level <= 0) return 1;
      const s = F / Math.max(1, refZ - cam.z);
      const k = Math.max(0, Math.min(1, (s - 0.42) / 0.33));
      const base = n0.level === 1 ? 0.3 : n0.level === 2 ? 0.16 : 0.1;
      return base + (1 - base) * k;
    }
    if (id === selId) return 1;
    const n = byId[id];
    if (!n) return 0.18;
    let cur: ThemeNode | undefined = n;
    let steps = 0;
    while (cur && cur.parent) {
      steps++;
      if (cur.parent === selId) break;
      cur = byId[cur.parent];
    }
    if (cur && cur.parent === selId) {
      if (steps === 1) return 1;
      if (steps === 2) return 0.1;
      return 0.05;
    }
    let s: ThemeNode | undefined = byId[selId];
    while (s && s.parent) {
      if (s.parent === id) return 0.26;
      s = byId[s.parent];
    }
    return 0.05;
  }

  let fm: Record<string, number> = {};
  let fmFrom: Record<string, number> = {};
  let focusT0: number | null = null;
  let focusDur = 1500;
  let focusRaf: number | null = null;
  function tickFocus() {
    applyCam();
    focusRaf = focusT0 != null ? requestAnimationFrame(tickFocus) : null;
  }
  function startFocus() {
    fmFrom = { ...fm };
    focusT0 = performance.now();
    focusDur = 1600;
    if (!focusRaf) focusRaf = requestAnimationFrame(tickFocus);
  }

  function setAtIntro(v: boolean) {
    atIntro = v;
    toIntroBtn.hidden = v;
    updateNudge();
  }
  function updateNudge() {
    nudgeEl.hidden = !(nudgeOn && !selId && !atIntro);
  }

  const nodePos: Record<string, { sx: number; sy: number; m: number; dz: number; op: number }> = {};

  function applyCam() {
    const { cx, cy } = centerXY();
    const camZ = cam.z;
    const refDz = Math.max(NEAR + 1, refZ - camZ);

    territories.forEach((t) => {
      const dz = zForLvl(0) - camZ;
      if (dz <= NEAR) {
        t.el.style.opacity = '0';
        return;
      }
      const m = F / dz;
      const sx = cx + (t.x - cam.x) * m;
      const sy = cy + (t.y - cam.y) * m;
      t.el.style.transform = `translate(${sx.toFixed(1)}px,${sy.toFixed(1)}px) translate(-50%,-50%) scale(${m.toFixed(4)})`;
      let op = 0.11;
      if (m > 0.5) op *= Math.max(0, 1 - (m - 0.5) / 0.45);
      t.el.style.opacity = op.toFixed(3);
    });

    {
      const dzI = zForLvl(0) - camZ;
      if (dzI <= NEAR) {
        introEl.style.opacity = '0';
        introEl.style.pointerEvents = 'none';
      } else {
        const mI = F / dzI;
        const sxI = cx + (INTRO.x - cam.x) * mI;
        const syI = cy + (INTRO.y - cam.y) * mI;
        introEl.style.transform = `translate(${sxI.toFixed(1)}px,${syI.toFixed(1)}px) translate(-50%,-50%) scale(${(mI * 3.2).toFixed(4)})`;
        introEl.style.opacity = '1';
        introEl.style.pointerEvents = 'auto';
      }
    }

    let focusK = 1;
    let focusActive = false;
    if (focusT0 != null) {
      const tt = Math.min(1, (performance.now() - focusT0) / focusDur);
      focusK = tt < 0.5 ? 4 * tt * tt * tt : 1 - Math.pow(-2 * tt + 2, 3) / 2;
      if (tt >= 1) focusT0 = null;
      else focusActive = true;
    }

    DATA.nodes.forEach((n) => {
      const el = nodeEls[n.id];
      const wz = zForLvl(n.level);
      const dz = wz - camZ;
      if (dz <= NEAR) {
        el.style.opacity = '0';
        el.style.pointerEvents = 'none';
        return;
      }
      const m = F / dz;
      const sx = cx + (n.x - cam.x) * m;
      const sy = cy + (n.y - cam.y) * m;
      el.style.transform = `translate(${sx.toFixed(1)}px,${sy.toFixed(1)}px) translate(-50%,-50%) scale(${m.toFixed(4)})`;
      const ratio = dz / refDz;
      const fade = ratio <= 1 ? 1 : Math.max(0.05, 1 - (ratio - 1) / 1.7);
      let blur = ratio <= 1.05 ? 0 : Math.min(2.4, (ratio - 1.05) * 2.2);
      const tgtFm = focusMul(n.id);
      const fromFm = fmFrom[n.id] != null ? fmFrom[n.id] : tgtFm;
      const nfm = fromFm + (tgtFm - fromFm) * focusK;
      fm[n.id] = nfm;
      let op = fade * (0.5 + 0.5 * nfm);
      if (nfm >= 0.985) op = Math.max(op, 0.94);
      else blur = Math.max(blur, (1 - nfm) * 1.2);
      op = Math.max(op, 0.05);
      const nearFade = Math.min(1, Math.max(0, (dz - NEAR) / (NEAR * 1.2)));
      op *= nearFade;
      el.style.opacity = op.toFixed(2);
      const fmq = Math.round(nfm * 16) / 16;
      // Blur + multiple stacked drop-shadows, recomputed on every node every
      // frame, is expensive enough on some GPUs to visibly stutter or even
      // corrupt a frame during an active camera flight — so during motion
      // (see motion() below, same flag the SVG thread filter uses) fall back
      // to a single cheap brightness filter, and restore the full glow once
      // the camera actually settles.
      let filt: string;
      if (fxHeld) {
        filt = `brightness(${Math.min(1.08, 0.5 + 0.58 * fmq).toFixed(2)})`;
      } else {
        const blq = Math.round(blur * 3) / 3;
        filt = (blq > 0.1 ? `blur(${blq.toFixed(2)}px) ` : '') + `brightness(${Math.min(1.08, 0.5 + 0.58 * fmq).toFixed(2)})`;
        filt += ` drop-shadow(0 0 ${(8 + 14 * fmq).toFixed(0)}px ${hexA(n.color, 0.18 + 0.42 * fmq)})`;
        const lit = fmq >= 0.985 && (!!selId || focusActive || n.level <= 0);
        if (lit) filt += ' drop-shadow(0 0 24px rgba(255,209,130,0.45)) drop-shadow(0 0 58px rgba(255,196,110,0.22))';
      }
      el.style.filter = filt;
      el.style.zIndex = String(4000 - Math.round(dz / 40) * 20 + (nfm >= 0.985 ? 500 : 0));
      el.style.pointerEvents = op > 0.12 && nearFade > 0.5 ? 'auto' : 'none';
      el.style.outline = n.id === selId ? '2px solid #f4cb7a' : '';
      el.style.outlineOffset = n.id === selId ? '3px' : '';
      nodePos[n.id] = { sx, sy, m, dz, op };
    });

    if (manualPan && !flyRaf) {
      const inIntro = cam.y < INTRO_THRESHOLD && !selId;
      if (inIntro !== atIntro) setAtIntro(inIntro);
    }

    renderStrings();
  }

  // --- Camera flight (rAF-eased) ---
  let flyRaf: number | null = null;
  let flyTimer: number | undefined;
  function animateTo(target: { x: number; y: number; z: number }, dur = 700) {
    manualPan = false;
    const start = { x: cam.x, y: cam.y, z: cam.z };
    const t0 = performance.now();
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const step = (now: number) => {
      const k = Math.min(1, (now - t0) / dur);
      const e = ease(k);
      motion();
      cam.x = start.x + (target.x - start.x) * e;
      cam.y = start.y + (target.y - start.y) * e;
      cam.z = start.z + (target.z - start.z) * e;
      applyCam();
      if (k < 1) flyRaf = requestAnimationFrame(step);
    };
    cancelFly();
    flyRaf = requestAnimationFrame(step);
    flyTimer = window.setTimeout(() => {
      cam.x = target.x;
      cam.y = target.y;
      cam.z = target.z;
      applyCam();
    }, dur + 60);
  }
  function cancelFly() {
    if (flyRaf) cancelAnimationFrame(flyRaf);
    flyRaf = null;
    if (flyTimer) window.clearTimeout(flyTimer);
    flyTimer = undefined;
  }

  function fitBox(minx: number, miny: number, maxx: number, maxy: number, dur: number) {
    const { w, h } = vpSize();
    const availW = (w - (panelWidth || 0)) * 0.86;
    const availH = h * 0.9;
    const bw = Math.max(1, maxx - minx);
    const bh = Math.max(1, maxy - miny);
    let s = Math.min(availW / bw, availH / bh);
    s = Math.max(0.1, Math.min(3.6, s));
    const planeZ = fitZ != null ? fitZ : refZ;
    animateTo({ x: (minx + maxx) / 2, y: (miny + maxy) / 2, z: planeZ - F / s }, dur);
  }

  function fitOverview(dur = 1200) {
    const b = regionBBox();
    const pad = 480;
    refZ = zForLvl(0);
    fitZ = zForLvl(0);
    fitBox(b.minx - pad, b.miny - pad, b.maxx + pad, b.maxy + pad, dur);
  }

  function flyToIntro() {
    setAtIntro(true);
    userMoved = true;
    hideTip();
    panelWidth = 0;
    refZ = zForLvl(0);
    fitZ = zForLvl(0);
    startFocus();
    animateTo({ x: INTRO.x, y: INTRO.y, z: zForLvl(0) - overviewDz() }, 1400);
  }

  function zoomBy(f: number) {
    let dz = (refZ - cam.z) / f;
    dz = Math.max(NEAR + 60, Math.min(overviewDz() * 1.3, dz));
    animateTo({ x: cam.x, y: cam.y, z: refZ - dz }, 300);
  }

  // --- Wires: hand-drawn wobble + gentle "pluck" on select / ambient
  // "breeze" over time ---
  function bfs(start: string): Record<string, number> {
    const dist: Record<string, number> = { [start]: 0 };
    const q = [start];
    while (q.length) {
      const u = q.shift()!;
      (adj[u] || []).forEach((v) => {
        if (dist[v] == null) {
          dist[v] = dist[u] + 1;
          q.push(v);
        }
      });
    }
    return dist;
  }

  let vibTimer: number | undefined;
  let anyVib = false;
  function vibStep() {
    renderStrings(false);
    if (!anyVib && vibTimer) {
      window.clearInterval(vibTimer);
      vibTimer = undefined;
    }
  }

  function pluck(id: string, strength = 1) {
    const dist = bfs(id);
    const now = performance.now();
    lines.forEach((o) => {
      const da = dist[o.a] == null ? 99 : dist[o.a];
      const db = dist[o.b] == null ? 99 : dist[o.b];
      const d = Math.min(da, db);
      o.amp = strength * o.ampBase * Math.exp(-0.5 * d);
      o.delay = d * 60;
      o.t0 = now;
      o.dur = 3.8;
      o.decay = 1.25;
    });
    if (!vibTimer) vibTimer = window.setInterval(vibStep, 16);
  }

  function scheduleBreeze() {
    const next = 2400 + Math.random() * 6800;
    window.setTimeout(() => {
      breeze();
      scheduleBreeze();
    }, next);
  }
  function breeze() {
    if (!lines.length) return;
    const strength = 0.05 + Math.random() * 0.13;
    const origin = DATA.nodes[Math.floor(Math.random() * DATA.nodes.length)].id;
    const dist = bfs(origin);
    const now = performance.now();
    lines.forEach((o) => {
      const da = dist[o.a] == null ? 99 : dist[o.a];
      const db = dist[o.b] == null ? 99 : dist[o.b];
      const d = Math.min(da, db);
      const a = strength * o.ampBase * 0.32 * Math.exp(-0.4 * d) * (0.4 + Math.random() * 0.7);
      if (a > 0.0015) {
        o.amp = Math.max(o.amp, a);
        o.t0 = now;
        o.delay = d * 110 + Math.random() * 240;
        o.dur = 6.5;
        o.decay = 0.62;
      }
    });
    if (!vibTimer) vibTimer = window.setInterval(vibStep, 16);
  }

  // `force=false` (used by the ambient breeze/pluck ticker, which fires every
  // 16ms without the camera having moved) skips every line that isn't
  // currently vibrating — its geometry is unchanged since the last render,
  // so re-walking its knots and rewriting its path/attributes would just be
  // wasted work repeated dozens of times a second.
  function renderStrings(force = true) {
    const now = performance.now();
    let vib = false;
    lines.forEach((o) => {
      if (!force && o.amp < 0.001) return;
      const A = nodePos[o.a];
      const B = nodePos[o.b];
      if (!A || !B) {
        o.vis.style.display = 'none';
        o.halo.style.display = 'none';
        o.hit.style.display = 'none';
        return;
      }
      o.vis.style.display = '';
      o.halo.style.display = '';
      o.hit.style.display = '';
      let decayAmp = 0;
      let tt = 0;
      if (o.amp >= 0.001) {
        const t = (now - o.t0 - o.delay) / 1000;
        if (t < 0) vib = true;
        else if (t < o.dur) {
          vib = true;
          tt = t;
          decayAmp = o.amp * Math.exp(-o.decay * t);
        } else o.amp = 0;
      }
      const ax = A.sx;
      const ay = A.sy;
      const bx = B.sx;
      const by = B.sy;
      const dx = bx - ax;
      const dy = by - ay;
      const len = Math.hypot(dx, dy) || 1;
      const px = -dy / len;
      const py = dx / len;
      const pts: [number, number][] = [[ax, ay]];
      o.knots.forEach((k) => {
        const f = k.f;
        const env = Math.sin(Math.PI * f);
        const vibOff = decayAmp * env * Math.sin(2 * Math.PI * o.freq * tt + o.phase);
        const amt = (k.off * 0.07 + vibOff) * len;
        const sagY = len * 0.01 * env;
        pts.push([ax + dx * f + px * amt, ay + dy * f + py * amt + sagY]);
      });
      pts.push([bx, by]);
      let dpath = `M${ax.toFixed(1)} ${ay.toFixed(1)}`;
      for (let p = 0; p < pts.length - 1; p++) {
        const p0 = pts[p - 1] || pts[p];
        const p1 = pts[p];
        const p2 = pts[p + 1];
        const p3 = pts[p + 2] || pts[p + 1];
        const c1x = p1[0] + (p2[0] - p0[0]) / 6;
        const c1y = p1[1] + (p2[1] - p0[1]) / 6;
        const c2x = p2[0] - (p3[0] - p1[0]) / 6;
        const c2y = p2[1] - (p3[1] - p1[1]) / 6;
        dpath += ` C${c1x.toFixed(1)} ${c1y.toFixed(1)} ${c2x.toFixed(1)} ${c2y.toFixed(1)} ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
      }
      o.vis.setAttribute('d', dpath);
      o.halo.setAttribute('d', dpath);
      o.hit.setAttribute('x1', ax.toFixed(1));
      o.hit.setAttribute('y1', ay.toFixed(1));
      o.hit.setAttribute('x2', bx.toFixed(1));
      o.hit.setAttribute('y2', by.toFixed(1));
      const mAvg = (A.m + B.m) / 2;
      let w = Math.max(0.5, mAvg * 2.0);
      let op = 0.6 * Math.min(A.op, B.op);
      const fmA = fm[o.a] != null ? fm[o.a] : focusMul(o.a);
      const fmB = fm[o.b] != null ? fm[o.b] : focusMul(o.b);
      const fmMin = Math.min(fmA, fmB);
      op *= Math.max(selId ? 0.04 : 0.25, fmMin);
      let haloK = 0.22;
      if (selId && fmMin > 0.9) {
        w *= 1.3;
        op = Math.min(1, op + 0.22);
        haloK = 0.5;
      }
      if (o.hover) {
        w *= 1.7;
        op = Math.min(1, op + 0.4);
        haloK = 0.55;
      }
      o.vis.setAttribute('stroke-width', w.toFixed(2));
      o.vis.setAttribute('stroke-opacity', op.toFixed(2));
      o.halo.setAttribute('stroke-width', (w * 3).toFixed(2));
      o.halo.setAttribute('stroke-opacity', (op * haloK).toFixed(3));
    });
    anyVib = vib;
    if (vib && !vibTimer) vibTimer = window.setInterval(vibStep, 16);
  }

  function showTip(text: string, ev: PointerEvent) {
    tooltipEl.textContent = text;
    tooltipEl.hidden = false;
    moveTip(ev);
  }
  function moveTip(ev: PointerEvent) {
    const pad = 14;
    let x = ev.clientX + pad;
    let y = ev.clientY + pad;
    const w = tooltipEl.offsetWidth;
    const h = tooltipEl.offsetHeight;
    if (x + w > window.innerWidth - 8) x = ev.clientX - w - pad;
    if (y + h > window.innerHeight - 8) y = ev.clientY - h - pad;
    tooltipEl.style.left = `${x}px`;
    tooltipEl.style.top = `${y}px`;
  }
  function hideTip() {
    tooltipEl.hidden = true;
  }

  // --- Panel population ---
  function ancestorPath(id: string): ThemeNode[] {
    const path: ThemeNode[] = [];
    let p = byId[id]?.parent;
    while (p) {
      path.unshift(byId[p]);
      p = byId[p]?.parent ?? null;
    }
    return path;
  }

  function crumbLabel(n: ThemeNode) {
    return n.id === 'root' ? 'The making of' : n.label;
  }

  function select(id: string) {
    const n = byId[id];
    if (!n) return;
    selId = id;
    userMoved = true;
    hideTip();
    panelWidth = Math.min(452, viewport.clientWidth * 0.42);
    nudgeOn = false;
    updateNudge();
    panelHintEl.hidden = panelHintSeen;
    if (!panelHintSeen) panelHintShownThisSelection = true;
    refZ = zForLvl(n.level);
    fitZ = zForLvl(n.level);
    startFocus();
    pluck(id);

    // Breadcrumb
    const crumbWrap = document.getElementById('mk-breadcrumb')!;
    crumbWrap.innerHTML = '';
    ancestorPath(id).forEach((p) => {
      const span = document.createElement('span');
      span.className = 'mk-crumb';
      span.innerHTML = `<span class="mk-crumb-label">${escapeHtml(crumbLabel(p))}</span><span class="mk-crumb-sep">/</span>`;
      span.addEventListener('click', () => select(p.id));
      crumbWrap.appendChild(span);
    });
    const cur = document.createElement('span');
    cur.className = 'mk-crumb-label';
    cur.style.color = n.color;
    cur.textContent = crumbLabel(n);
    crumbWrap.appendChild(cur);

    (document.getElementById('mk-panel-title') as HTMLElement).textContent = crumbLabel(n);

    const authorsEl = document.getElementById('mk-panel-authors')!;
    if (n.authors) {
      authorsEl.hidden = false;
      authorsEl.textContent = `DRAFT · ${n.authors}`;
    } else {
      authorsEl.hidden = true;
    }

    (document.getElementById('mk-panel-rule') as HTMLElement).style.background = n.color;
    renderBlocks(n.blocks);

    const qWrap = document.getElementById('mk-panel-questions')!;
    const qList = document.getElementById('mk-panel-questions-list')!;
    qList.innerHTML = '';
    if (n.questions.length) {
      qWrap.hidden = false;
      n.questions.forEach((q) => {
        const d = document.createElement('div');
        d.className = 'mk-question';
        d.style.borderColor = n.color;
        d.textContent = q;
        qList.appendChild(d);
      });
    } else {
      qWrap.hidden = true;
    }

    const cWrap = document.getElementById('mk-panel-children')!;
    const cList = document.getElementById('mk-panel-children-list')!;
    cList.innerHTML = '';
    if (n.children.length) {
      cWrap.hidden = false;
      n.children.forEach((cid) => {
        const c = byId[cid];
        const row = document.createElement('div');
        row.className = 'mk-child-row';
        row.innerHTML = `<span class="mk-child-num">${escapeHtml(c.number)}</span><span class="mk-child-label">${escapeHtml(c.label)}</span>`;
        row.addEventListener('click', () => select(cid));
        cList.appendChild(row);
      });
    } else {
      cWrap.hidden = true;
    }

    const connWrap = document.getElementById('mk-panel-connections')!;
    const connList = document.getElementById('mk-panel-connections-list')!;
    connList.innerHTML = '';
    const conns = DATA.links
      .filter((l) => l.from === id || l.to === id)
      .map((l) => (l.from === id ? { other: byId[l.to], note: l.note } : { other: byId[l.from], note: l.note }));
    if (conns.length) {
      connWrap.hidden = false;
      conns.forEach(({ other, note }) => {
        const row = document.createElement('div');
        row.className = 'mk-conn';
        row.innerHTML = `<div class="mk-conn-head"><span class="mk-conn-num">${escapeHtml(other.number)} →</span><span class="mk-conn-label">${escapeHtml(other.label)}</span></div><div class="mk-conn-text">${escapeHtml(note)}</div>`;
        row.addEventListener('click', () => select(other.id));
        connList.appendChild(row);
      });
    } else {
      connWrap.hidden = true;
    }

    const parentWrap = document.getElementById('mk-panel-parent')!;
    parentWrap.innerHTML = '';
    if (n.parent) {
      parentWrap.hidden = false;
      const p = byId[n.parent];
      const link = document.createElement('span');
      link.className = 'mk-parent-link';
      link.textContent = `← Part of ${p.number} · ${crumbLabel(p)}`;
      link.addEventListener('click', () => select(p.id));
      parentWrap.appendChild(link);
    } else {
      parentWrap.hidden = true;
    }

    panel.hidden = false;
    setAtIntro(false);
    toIntroBtn.hidden = false;

    const kids = n.children.map((cid) => byId[cid]);
    const pts = [n, ...kids];
    const minx = Math.min(...pts.map((p) => p.x));
    const miny = Math.min(...pts.map((p) => p.y));
    const maxx = Math.max(...pts.map((p) => p.x));
    const maxy = Math.max(...pts.map((p) => p.y));
    const pad = kids.length ? 360 : 300;
    fitBox(minx - pad, miny - pad, maxx + pad, maxy + pad, 1700);
  }

  function deselect() {
    selId = null;
    if (panelHintShownThisSelection && !panelHintSeen) {
      try {
        localStorage.setItem('pa-mk-hint-panel', '1');
      } catch (e) {}
      panelHintSeen = true;
    }
    panel.hidden = true;
    panelWidth = 0;
    refZ = zForLvl(0);
    fitZ = zForLvl(0);
    startFocus();
    setAtIntro(false);
    fitOverview(1500);
  }

  function escapeHtml(s: string) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  // Renders each node's content blocks in the exact order an editor set in
  // the CMS, so text and media interleave however they chose — not a fixed
  // "text then media" layout.
  const blocksWrap = document.getElementById('mk-panel-blocks')!;
  function renderBlocks(blocks: ContentBlock[]) {
    blocksWrap.innerHTML = '';
    blocks.forEach((b) => {
      if (b.type === 'text') {
        const p = document.createElement('div');
        p.className = 'mk-block-text';
        p.textContent = b.text || '';
        blocksWrap.appendChild(p);
        return;
      }
      const wrap = document.createElement('div');
      wrap.className = 'mk-block-media';
      const src = b.file || '';
      if (b.type === 'image') {
        const img = document.createElement('img');
        img.src = src;
        img.alt = b.caption || '';
        img.loading = 'lazy';
        wrap.appendChild(img);
      } else if (b.type === 'video') {
        const video = document.createElement('video');
        video.src = src;
        video.controls = true;
        wrap.appendChild(video);
      } else if (b.type === 'audio') {
        const audioWrap = document.createElement('div');
        audioWrap.className = 'mk-block-audio-wrap';
        const audio = document.createElement('audio');
        audio.src = src;
        audio.controls = true;
        audioWrap.appendChild(audio);
        wrap.appendChild(audioWrap);
      }
      if (b.caption) {
        const cap = document.createElement('div');
        cap.className = 'mk-block-caption';
        cap.textContent = b.caption;
        wrap.appendChild(cap);
      }
      blocksWrap.appendChild(wrap);
    });
  }

  // --- Pan / zoom interaction ---
  // Click-to-select is handled here (not via a plain `click` listener on each
  // node/link) because `setPointerCapture` below redirects the click that
  // follows a captured pointer sequence to the capturing element, so a
  // listener on the node itself never fires.
  let drag: { x: number; y: number; sx: number; sy: number; moved: boolean; target: EventTarget | null } | null = null;

  viewport.addEventListener('pointerdown', (e) => {
    if (e.button !== 0) return;
    drag = { x: e.clientX, y: e.clientY, sx: e.clientX, sy: e.clientY, moved: false, target: e.target };
    viewport.setPointerCapture(e.pointerId);
    viewport.classList.add('is-dragging');
  });
  viewport.addEventListener('pointermove', (e) => {
    if (!drag) return;
    const dx = e.clientX - drag.x;
    const dy = e.clientY - drag.y;
    if (Math.abs(e.clientX - drag.sx) + Math.abs(e.clientY - drag.sy) > 5) {
      drag.moved = true;
      userMoved = true;
      manualPan = true;
    }
    const mRef = F / Math.max(1, refZ - cam.z);
    cam.x -= dx / mRef;
    cam.y -= dy / mRef;
    drag.x = e.clientX;
    drag.y = e.clientY;
    motion();
    cancelFly();
    applyCam();
  });
  function endDrag() {
    viewport.classList.remove('is-dragging');
    const result = drag && !drag.moved ? { wasClick: true, target: drag.target } : { wasClick: false, target: null };
    drag = null;
    return result;
  }
  viewport.addEventListener('pointerup', () => {
    const { wasClick, target } = endDrag();
    if (!wasClick) return;
    const el = target as HTMLElement | null;
    if (el?.closest('.mk-link-hit')) return;
    // The intro's enter button lives inside #mk-viewport (so it can be
    // camera-projected like a node) — pointer capture above redirects the
    // native click away from it for real mouse/touch input, so route it the
    // same way node selection is routed.
    if (el?.closest('#mk-intro-close')) {
      userMoved = true;
      deselect();
      return;
    }
    const nodeEl = el?.closest<HTMLElement>('.mk-node');
    if (nodeEl?.dataset.id) select(nodeEl.dataset.id);
    else if (selId) deselect();
  });
  viewport.addEventListener('pointercancel', () => endDrag());

  let exitT = 0;
  let exitAcc = 0;
  viewport.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      userMoved = true;
      manualPan = true;
      const rect = viewport.getBoundingClientRect();
      const mx = e.clientX - rect.left;
      const my = e.clientY - rect.top;
      const { cx, cy } = centerXY();
      const dz0 = Math.max(NEAR + 1, refZ - cam.z);
      const maxDz = overviewDz() * 1.3;

      // Pulling back past the overview edge flies back up to the intro.
      if (e.deltaY > 0 && !selId && !atIntro && dz0 >= maxDz * 0.98) {
        const now = performance.now();
        if (!exitT || now - exitT > 900) exitAcc = 0;
        exitT = now;
        exitAcc += e.deltaY;
        if (exitAcc > 260) {
          exitAcc = 0;
          flyToIntro();
        }
        return;
      }

      const m0 = F / dz0;
      const worldX = cam.x + (mx - cx) / m0;
      const worldY = cam.y + (my - cy) / m0;
      // Zoom step per wheel event (the magnitude of deltaY is deliberately
      // ignored, so a trackpad's many small events don't rocket through the
      // zoom range). These are the previous 1.07 / 0.934 steps raised to
      // 1/1.6, i.e. reaching any given zoom now takes ~60% more physical
      // scrolling. Keep them near-reciprocal so zooming in then back out
      // returns to roughly where you started.
      const f = e.deltaY < 0 ? 1.0432 : 0.9582;
      let dz1 = dz0 / f;
      dz1 = Math.max(NEAR + 60, Math.min(maxDz, dz1));
      const m1 = F / dz1;
      cam.z = refZ - dz1;
      cam.x = worldX - (mx - cx) / m1;
      cam.y = worldY - (my - cy) / m1;
      motion();
      cancelFly();
      applyCam();
    },
    { passive: false },
  );

  // --- Header / intro controls ---
  document.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const act = btn.dataset.act;
      if (act === 'overview' || act === 'close') deselect();
      else if (act === 'zoom-in') zoomBy(1.35);
      else if (act === 'zoom-out') zoomBy(0.74);
    });
  });

  document.getElementById('mk-intro-close')!.addEventListener('click', () => {
    userMoved = true;
    deselect();
  });
  toIntroBtn.addEventListener('click', () => {
    if (selId) deselect();
    flyToIntro();
  });

  window.addEventListener('resize', () => applyCam());
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && selId) deselect();
  });

  // --- Init ---
  function measureHeader() {
    const header = document.querySelector<HTMLElement>('.hd-header');
    if (header) document.documentElement.style.setProperty('--mk-header-h', `${header.offsetHeight}px`);
  }
  function syncHeaderHeight() {
    measureHeader();
    applyCam();
  }
  window.addEventListener('resize', syncHeaderHeight);

  // Seat the camera at the fitted overview distance *before* the first
  // paint. cam.z starts at 0, i.e. the camera sitting almost on top of the
  // intro card (dz = 340, so ~12x scale), and initFit below only pulled it
  // back to the fitted distance a tick later — which showed as the intro
  // text appearing hugely magnified before snapping into place. Measure the
  // header first: overviewDz() fits to the viewport, whose height depends on
  // the --mk-header-h that measureHeader() sets.
  measureHeader();
  cam.z = zForLvl(0) - overviewDz();
  syncHeaderHeight();

  updateNudge();
  scheduleBreeze();

  // Camera starts on the intro; a short settle loop re-fits it as the
  // viewport's real size becomes available (fonts/layout can shift it late,
  // e.g. once web fonts finish loading and the header re-wraps). Each tick
  // only actually repaints (33 nodes plus the SVG-filtered wires) when the
  // computed camera target has genuinely changed from last time — otherwise
  // this would repaint the whole scene on a fixed timer regardless of
  // whether anything moved, which is expensive enough (the turbulence
  // filter especially) to visibly stutter for the ~2s this loop runs.
  let fitTries = 0;
  let lastFitZ: number | null = null;
  function initFit() {
    if (userMoved) return;
    const z = zForLvl(0) - overviewDz();
    if (z !== lastFitZ) {
      lastFitZ = z;
      motion();
      refZ = zForLvl(0);
      fitZ = zForLvl(0);
      cam.x = INTRO.x;
      cam.y = INTRO.y;
      cam.z = z;
      applyCam();
    }
    if (++fitTries < 22) window.setTimeout(initFit, 90);
  }
  window.setTimeout(initFit, 30);
</script>
