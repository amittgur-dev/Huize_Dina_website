</style>

<script>
  // On phones the hierarchical browser (#mkm) replaces the map entirely, so
  // skip building the map's DOM and camera. Crossing the breakpoint (e.g.
  // rotating a tablet or resizing a window) reloads once to swap modes —
  // cheaper and far simpler than tearing either mode down live.
  const MKM_MQ = window.matchMedia('(max-width: 680px)');
  MKM_MQ.addEventListener('change', () => location.reload());
  if (!MKM_MQ.matches) initMap();

  function initMap() {
  interface ContentBlock {
    type: 'text' | 'image' | 'audio' | 'video';
    text: string | null;
    file: string | null;
    caption: string | null;
  }
  interface ThemeNode {
    id: string;
    number: string;
    label: string;
    level: number;
    parent: string | null;
    blocks: ContentBlock[];
    questions: string[];
    authors: string | null;
    color: string;
    x: number;
    y: number;
    children: string[];
  }
  interface ThemeLink {
    from: string;
    to: string;
    note: string;
  }

  const DATA: { nodes: ThemeNode[]; links: ThemeLink[]; regionColors: Record<string, string>; bbox: any } = JSON.parse(
    document.getElementById('mk-data')!.textContent || '{}',
  );

  const byId: Record<string, ThemeNode> = {};
  DATA.nodes.forEach((n) => (byId[n.id] = n));
  const root = DATA.nodes.find((n) => n.level === -1)!;

  const LEVEL_CFG: Record<
    number,
    { width: number; font: number; border: number; blob: 'a' | 'b'; bg: string; shadow: string; padding: string }
  > = {
    [-1]: { width: 1400, font: 124, border: 4, blob: 'a', bg: 'rgba(40,36,48,0.82)', shadow: '0 18px 44px rgba(0,0,0,0.5)', padding: '46px 60px' },
    0: { width: 760, font: 84, border: 3.5, blob: 'a', bg: 'rgba(38,34,46,0.7)', shadow: '0 14px 32px rgba(0,0,0,0.46)', padding: '30px 36px' },
    1: { width: 440, font: 44, border: 2.5, blob: 'b', bg: 'rgba(34,30,42,0.66)', shadow: '0 9px 22px rgba(0,0,0,0.4)', padding: '18px 22px' },
    2: { width: 380, font: 36, border: 2.5, blob: 'a', bg: 'rgba(30,27,38,0.62)', shadow: '0 6px 15px rgba(0,0,0,0.36)', padding: '14px 18px' },
    3: { width: 330, font: 31, border: 2.5, blob: 'b', bg: 'rgba(26,23,33,0.58)', shadow: '0 4px 11px rgba(0,0,0,0.32)', padding: '12px 16px' },
  };
  const BLOB_A = '332px 20px 293px 20px / 20px 293px 20px 332px';
  const BLOB_B = '18px 306px 18px 319px / 306px 18px 319px 18px';

  const viewport = document.getElementById('mk-viewport')!;
  const linesSvg = document.getElementById('mk-lines') as unknown as SVGSVGElement;
  const terrLayer = document.getElementById('mk-terr')!;
  const nodesLayer = document.getElementById('mk-nodes')!;
  const panel = document.getElementById('mk-panel')!;
  const introEl = document.getElementById('mk-intro')!;
  const toIntroBtn = document.getElementById('mk-to-intro')!;
  const nudgeEl = document.getElementById('mk-nudge')!;
  const tooltipEl = document.getElementById('mk-tooltip')!;
  const panelHintEl = document.getElementById('mk-panel-hint')!;

  function hexA(hex: string, a: number) {
    const v = Math.max(0, Math.min(1, a));
    return hex.slice(0, 7) + Math.round(v * 255).toString(16).padStart(2, '0');
  }

  // --- Build node DOM. Position is driven entirely by the 3D camera every
  // frame (see applyCam below) — these elements carry no left/top of their
  // own, only their level-based size/shape/color. ---
  const nodeEls: Record<string, HTMLElement> = {};
  DATA.nodes.forEach((n) => {
    const cfg = LEVEL_CFG[n.level] || LEVEL_CFG[3];
    const el = document.createElement('div');
    el.className = `mk-node lvl-${n.level}`;
    el.dataset.id = n.id;
    el.style.width = `${cfg.width}px`;
    el.style.background = cfg.bg;
    el.style.border = `${cfg.border}px solid ${n.color}`;
    el.style.borderRadius = cfg.blob === 'a' ? BLOB_A : BLOB_B;
    el.style.padding = cfg.padding;
    el.style.boxShadow = cfg.shadow;

    const title = document.createElement('div');
    title.className = 'mk-node-title';
    title.style.fontSize = `${cfg.font}px`;
    title.style.fontWeight = n.level <= -1 ? '700' : '400';

    if (n.level >= 1) {
      const num = document.createElement('div');
      num.className = 'mk-node-num';
      num.style.fontSize = `${cfg.font * 0.44}px`;
      num.style.color = n.color;
      num.style.marginBottom = `${cfg.font * 0.18}px`;
      num.textContent = n.number;
      el.appendChild(num);
    }

    title.textContent = n.label;
    el.appendChild(title);

    if (n.children.length && n.level <= 1) {
      const sub = document.createElement('div');
      sub.className = 'mk-node-sub';
      sub.style.fontSize = `${cfg.font * 0.19}px`;
      sub.style.marginTop = `${cfg.font * 0.18}px`;
      sub.textContent = `${n.children.length} sub-theme${n.children.length > 1 ? 's' : ''} →`;
      el.appendChild(sub);
    }

    nodesLayer.appendChild(el);
    nodeEls[n.id] = el;
  });

  // --- Region territory labels: giant background text sized to each
  // region's own node cluster, its position computed from the auto-layout
  // (no hardcoded spots) by walking each node up to its level-0 ancestor. ---
  function topRegion(n: ThemeNode): ThemeNode | null {
    let cur: ThemeNode | undefined = n;
    while (cur && cur.level > 0) cur = cur.parent ? byId[cur.parent] : undefined;
    return cur && cur.level === 0 ? cur : null;
  }
  const regionGroups: Record<string, { label: string; color: string; sx: number; sy: number; n: number }> = {};
  DATA.nodes.forEach((n) => {
    const reg = topRegion(n);
    if (!reg) return;
    const g = (regionGroups[reg.id] ??= { label: reg.label, color: reg.color, sx: 0, sy: 0, n: 0 });
    g.sx += n.x;
    g.sy += n.y;
    g.n += 1;
  });
  const territories = Object.values(regionGroups).map((g) => {
    const el = document.createElement('div');
    el.className = 'mk-terr-label';
    el.style.color = g.color;
    el.textContent = g.label.toUpperCase();
    terrLayer.appendChild(el);
    return { el, x: g.sx / g.n, y: g.sy / g.n };
  });

  // --- Build SVG lines: hierarchy ("belongs to — sub-theme") wires only.
  // Cross-region relationships (content/themes/cross-links.json) stay fully
  // intact as data and surface as clickable cards in the reading panel's
  // "Connections" section — they're just not drawn as wires here. Each wire
  // is a slightly irregular, hand-drawn-looking thread (a few random knots
  // baked into its own geometry) that plucks when you select its branch.
  // No SVG filter: the turbulence pass was the single heaviest repaint on
  // the page and made the wires visibly shift each time the map stopped. ---
  const NS = 'http://www.w3.org/2000/svg';
  linesSvg.innerHTML = '';
  const fxGroup = document.createElementNS(NS, 'g');
  const haloLayer = document.createElementNS(NS, 'g');
  const coreLayer = document.createElementNS(NS, 'g');
  fxGroup.appendChild(haloLayer);
  fxGroup.appendChild(coreLayer);
  linesSvg.appendChild(fxGroup);
  const hitLayer = document.createElementNS(NS, 'g');
  linesSvg.appendChild(hitLayer);

  interface Knot {
    f: number;
    off: number;
  }
  interface LineRec {
    a: string;
    b: string;
    halo: SVGPathElement;
    vis: SVGPathElement;
    hit: SVGLineElement;
    knots: Knot[];
    freq: number;
    phase: number;
    ampBase: number;
    amp: number;
    t0: number;
    delay: number;
    dur: number;
    decay: number;
    hover: boolean;
  }
  const lines: LineRec[] = [];
  const adj: Record<string, string[]> = {};
  function addAdj(x: string, y: string) {
    (adj[x] ??= []).push(y);
    (adj[y] ??= []).push(x);
  }

  function addLine(a: ThemeNode, b: ThemeNode) {
    const halo = document.createElementNS(NS, 'path');
    halo.setAttribute('class', 'mk-link');
    halo.setAttribute('stroke', '#cbd2d4');
    const vis = document.createElementNS(NS, 'path');
    vis.setAttribute('class', 'mk-link');
    vis.setAttribute('stroke', '#ffffff');
    const hit = document.createElementNS(NS, 'line');
    hit.setAttribute('class', 'mk-link-hit');
    haloLayer.appendChild(halo);
    coreLayer.appendChild(vis);
    hitLayer.appendChild(hit);

    const wlen = Math.hypot(b.x - a.x, b.y - a.y);
    const nK = 3 + Math.floor(Math.random() * 2);
    const knots: Knot[] = [];
    for (let q = 1; q <= nK; q++) {
      let f = q / (nK + 1) + (Math.random() * 2 - 1) * 0.04;
      f = Math.max(0.06, Math.min(0.94, f));
      knots.push({ f, off: (Math.random() * 2 - 1) * 0.05 });
    }
    knots.sort((p, q2) => p.f - q2.f);

    const rec: LineRec = {
      a: a.id,
      b: b.id,
      halo,
      vis,
      hit,
      knots,
      freq: Math.max(1.0, Math.min(2.6, 820 / wlen)),
      phase: Math.random() * 6.283,
      ampBase: 0.045 + Math.random() * 0.025,
      amp: 0,
      t0: 0,
      delay: 0,
      dur: 3.4,
      decay: 1.45,
      hover: false,
    };
    hit.addEventListener('pointerenter', (ev) => {
      rec.hover = true;
      showTip(`${b.label} — sub-theme of ${a.label}`, ev as PointerEvent);
      requestRender();
    });
    hit.addEventListener('pointermove', (ev) => moveTip(ev as PointerEvent));
    hit.addEventListener('pointerleave', () => {
      rec.hover = false;
      hideTip();
      requestRender();
    });
    lines.push(rec);
  }

  DATA.nodes.forEach((n) => {
    if (n.parent && byId[n.parent]) addAdj(n.parent, n.id);
  });
  DATA.nodes.forEach((n) => {
    if (n.parent && byId[n.parent]) addLine(byId[n.parent], n);
  });

  // =====================================================================
  // Engine. Everything that moves — camera flights, pan inertia, eased
  // zoom, the focal plane, the panel's projection-centre shift, the
  // spotlight fade, the lamp, wire vibration — advances inside ONE
  // requestAnimationFrame pass (frame() below) that draws once and goes
  // back to sleep the moment nothing is changing. Input handlers only
  // update state and call requestRender(); they never draw directly.
  // =====================================================================
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // --- Camera: a fake-3D perspective camera (F/dz projection) applied to
  // each node's auto-computed (x,y) plus a fixed z-depth per hierarchy
  // level — this is what gives the map its depth-of-field "fly through"
  // feel while still needing zero hand-placed coordinates. ---
  const F = 1300;
  const NEAR = 240;
  const ZLEVEL: Record<number, number> = { [-1]: 40, 0: 340, 1: 660, 2: 980, 3: 1300 };
  function zForLvl(l: number) {
    return ZLEVEL[l] ?? 0;
  }

  // The intro card lives at a world position above the map itself — the
  // camera starts there and "flies down" into the map on entry, and back up
  // again via the Intro pill or by pulling back past the overview edge.
  const INTRO = { x: root.x, y: root.y - 2980 };
  const INTRO_THRESHOLD = INTRO.y + 1060;

  const cam = { x: INTRO.x, y: INTRO.y, z: 0 };
  // refZ is the focal reference plane (drives depth-fade and pan speed);
  // fitZ is the plane the next camera fit is computed against.
  let refZ = zForLvl(0);
  let fitZ = zForLvl(0);
  // panelWidth is the reading panel's width once open (what camera fits
  // are computed for); `shift` is the eased value the scene is actually
  // drawn with. Keeping them separate is what stops the whole map jumping
  // sideways in a single frame when the panel joins or leaves.
  let panelWidth = 0;
  let shift = 0;
  let selId: string | null = null;
  let atIntro = true;
  let userMoved = false;
  let manualPan = false;
  let nudgeOn = true;
  let panelHintSeen = false;
  let panelHintShownThisSelection = false;
  try {
    panelHintSeen = !!localStorage.getItem('pa-mk-hint-panel');
  } catch (e) {}

  // Layout is read here only — on load, resize, and font settle — never in
  // the per-frame path, where a read right after a style write forces the
  // browser to recalculate layout mid-frame.
  let vpW = 0;
  let vpH = 0;
  let vpLeft = 0;
  let vpTop = 0;
  let introH = 0;
  const nodeH: Record<string, number> = {};
  function measure() {
    const r = viewport.getBoundingClientRect();
    vpW = r.width;
    vpH = r.height;
    vpLeft = r.left;
    vpTop = r.top;
    introH = introEl.offsetHeight;
    DATA.nodes.forEach((n) => (nodeH[n.id] = nodeEls[n.id].offsetHeight));
  }
  function panelW() {
    // matches the CSS: min(452px, 42vw), and a full-width sheet under 780px
    // (where there is no map left beside it to re-centre)
    return vpW <= 780 ? 0 : Math.min(452, vpW * 0.42);
  }
  function centerXY() {
    return { cx: (vpW - shift) / 2, cy: vpH / 2 };
  }

  const REGION_BB = (() => {
    let minx = Infinity;
    let miny = Infinity;
    let maxx = -Infinity;
    let maxy = -Infinity;
    DATA.nodes.forEach((n) => {
      if (n.level <= 0) {
        minx = Math.min(minx, n.x);
        miny = Math.min(miny, n.y);
        maxx = Math.max(maxx, n.x);
        maxy = Math.max(maxy, n.y);
      }
    });
    return { minx, miny, maxx, maxy };
  })();

  // Everything the overview shows lit: root, regions and their first ring.
  // The overview is framed to this, so no first-ring theme is cropped by
  // the screen edge.
  const OVERVIEW_BB = (() => {
    let minx = Infinity;
    let miny = Infinity;
    let maxx = -Infinity;
    let maxy = -Infinity;
    DATA.nodes.forEach((n) => {
      if (n.level <= 1) {
        minx = Math.min(minx, n.x);
        miny = Math.min(miny, n.y);
        maxx = Math.max(maxx, n.x);
        maxy = Math.max(maxy, n.y);
      }
    });
    return { minx, miny, maxx, maxy };
  })();
  const OVERVIEW_PAD = 190;

  // Camera distance that frames the intro card (unchanged from the
  // original: it sets how large the intro text is drawn).
  function introDz() {
    if (!vpW || !vpH) return F * 6;
    const pad = 460;
    const bw = REGION_BB.maxx - REGION_BB.minx + pad * 2;
    const bh = REGION_BB.maxy - REGION_BB.miny + pad * 2;
    let s = Math.min((vpW * 0.97) / bw, (vpH * 0.97) / bh);
    s = Math.max(0.1, Math.min(1.2, s));
    return F / s;
  }
  // Camera distance of the map overview (same fill factors as boxTarget).
  function mapDz() {
    if (!vpW || !vpH) return F * 6;
    const bw = OVERVIEW_BB.maxx - OVERVIEW_BB.minx + OVERVIEW_PAD * 2;
    const bh = OVERVIEW_BB.maxy - OVERVIEW_BB.miny + OVERVIEW_PAD * 2;
    let s = Math.min((vpW * 0.86) / bw, (vpH * 0.9) / bh);
    s = Math.max(0.1, Math.min(3.6, s));
    return F / s;
  }
  function maxDz() {
    return Math.max(introDz(), mapDz()) * 1.3;
  }

  // --- Spotlight: which nodes are "lit" right now.
  // Browsing (nothing selected): the overview shows the shape of the map —
  // root, the four regions, and their first ring — and deeper levels only
  // come up as you zoom in. Reading (a theme selected): house lights down.
  // The theme and its direct sub-themes are fully lit, its ancestors stay
  // faintly visible as a path home, and everything else sinks to near
  // black so the map stops competing with the text. ---
  function focusMul(id: string): number {
    if (!selId) {
      const n0 = byId[id];
      if (!n0 || n0.level <= 0) return 1;
      const s = F / Math.max(1, refZ - cam.z);
      const k = Math.max(0, Math.min(1, (s - 0.46) / 0.36));
      if (n0.level === 1) return 0.62 + 0.38 * k;
      return k * k;
    }
    if (id === selId) return 1;
    const n = byId[id];
    if (!n) return 0.03;
    let cur: ThemeNode | undefined = n;
    let steps = 0;
    while (cur && cur.parent) {
      steps++;
      if (cur.parent === selId) break;
      cur = byId[cur.parent];
    }
    if (cur && cur.parent === selId) {
      if (steps === 1) return 1;
      if (steps === 2) return 0.12;
      return 0.03;
    }
    let s: ThemeNode | undefined = byId[selId];
    while (s && s.parent) {
      if (s.parent === id) return 0.2;
      s = byId[s.parent];
    }
    return 0.03;
  }

  let fm: Record<string, number> = {};
  let fmFrom: Record<string, number> = {};
  let focusT0: number | null = null;
  let focusDur = 900;
  // readK: 0 = browsing, 1 = reading. Eased with the spotlight; it dims the
  // region captions and unrelated wires and brings the lamp up.
  let readK = 0;
  let readFrom = 0;
  const zBoost: Record<string, number> = {};
  function startFocus() {
    fmFrom = { ...fm };
    readFrom = readK;
    focusT0 = performance.now();
    focusDur = REDUCED ? 0 : 900;
    // Lit nodes sit above dimmed ones. Decided once per selection rather
    // than at a brightness threshold mid-fade, which used to make
    // overlapping nodes swap stacking order in a single frame.
    DATA.nodes.forEach((n) => (zBoost[n.id] = selId && focusMul(n.id) >= 0.99 ? 500 : 0));
    requestRender();
  }

  function setAtIntro(v: boolean) {
    atIntro = v;
    toIntroBtn.hidden = v;
    updateNudge();
  }
  function updateNudge() {
    nudgeEl.hidden = !(nudgeOn && !selId && !atIntro);
  }

  // --- Motion state, all advanced by frame() ---
  // Soft start, long settle: moving within the first frames after a click
  // (the old in-out cubic covered 0.4% of the distance in its first 10%).
  const ease = (k: number) => 1 - Math.pow(1 - Math.pow(k, 1.6), 3);
  interface Tween {
    from: number;
    to: number;
    t0: number;
    dur: number;
  }
  function tweenVal(tw: Tween, now: number) {
    const k = tw.dur <= 0 ? 1 : Math.min(1, (now - tw.t0) / tw.dur);
    return { v: tw.from + (tw.to - tw.from) * ease(k), done: k >= 1 };
  }
  let flight: { sx: number; sy: number; sz: number; tx: number; ty: number; tz: number; plane: number; t0: number; dur: number } | null =
    null;
  // The focal plane and the centre shift ride their own tweens (started
  // together with a flight, same duration and curve) so that interrupting
  // the flight by grabbing the map doesn't strand them half-way.
  let refTw: Tween | null = null;
  let shiftTw: Tween | null = null;
  let inertia: { vx: number; vy: number } | null = null; // screen px / ms
  let zoom: { dzT: number; mx: number; my: number; wx: number; wy: number } | null = null;

  function flyTo(target: { x: number; y: number; z: number }, opts: { refZ?: number; shift?: number; dur?: number } = {}) {
    manualPan = false;
    inertia = null;
    zoom = null;
    const dist = Math.hypot(target.x - cam.x, target.y - cam.y) + Math.abs(target.z - cam.z);
    let dur = opts.dur ?? Math.max(750, Math.min(1350, 650 + dist * 0.22));
    if (REDUCED) dur = 0;
    const now = performance.now();
    flight = {
      sx: cam.x,
      sy: cam.y,
      sz: cam.z,
      tx: target.x,
      ty: target.y,
      tz: target.z,
      plane: opts.refZ ?? refZ,
      t0: now,
      dur,
    };
    if (opts.refZ != null) refTw = { from: refZ, to: opts.refZ, t0: now, dur };
    if (opts.shift != null) shiftTw = { from: shift, to: opts.shift, t0: now, dur };
    requestRender();
  }

  // Zoom towards a screen point. Wheel, pinch, the +/- buttons and keys all
  // feed the same target, which the camera then eases toward — so repeated
  // input accumulates instead of restarting, and a mouse notch no longer
  // lands as a visible step.
  function zoomAt(mx: number, my: number, factor: number) {
    flight = null;
    inertia = null;
    manualPan = true;
    userMoved = true;
    const { cx, cy } = centerXY();
    const dzNow = Math.max(NEAR + 1, refZ - cam.z);
    const base = zoom ? zoom.dzT : dzNow;
    const dzT = Math.max(NEAR + 60, Math.min(maxDz(), base / factor));
    const m0 = F / dzNow;
    zoom = { dzT, mx, my, wx: cam.x + (mx - cx) / m0, wy: cam.y + (my - cy) / m0 };
    requestRender();
  }
  function zoomBy(f: number) {
    zoomAt((vpW - shift) / 2, vpH / 2, f);
  }

  let rafId: number | null = null;
  let lastNow = 0;
  let lampBusy = false;
  function requestRender() {
    if (rafId == null) rafId = requestAnimationFrame(frame);
  }
  function frame(now: number) {
    rafId = null;
    const dt = lastNow ? Math.min(48, now - lastNow) : 16.7;
    lastNow = now;
    let active = false;

    if (flight) {
      const k = flight.dur <= 0 ? 1 : Math.min(1, (now - flight.t0) / flight.dur);
      const e = ease(k);
      cam.x = flight.sx + (flight.tx - flight.sx) * e;
      cam.y = flight.sy + (flight.ty - flight.sy) * e;
      // Depth is eased in log-distance from the destination's focal plane,
      // so the apparent zoom rate stays even instead of rushing at the end.
      const d0 = flight.plane - flight.sz;
      const d1 = flight.plane - flight.tz;
      cam.z = d0 > 1 && d1 > 1 ? flight.plane - d0 * Math.pow(d1 / d0, e) : flight.sz + (flight.tz - flight.sz) * e;
      if (k >= 1) flight = null;
      else active = true;
    }
    if (inertia) {
      const mRef = F / Math.max(1, refZ - cam.z);
      cam.x -= (inertia.vx * dt) / mRef;
      cam.y -= (inertia.vy * dt) / mRef;
      const decay = Math.exp(-dt / 260);
      inertia.vx *= decay;
      inertia.vy *= decay;
      if (Math.hypot(inertia.vx, inertia.vy) < 0.02) inertia = null;
      else active = true;
    }
    if (refTw) {
      const r = tweenVal(refTw, now);
      refZ = r.v;
      if (r.done) refTw = null;
      else active = true;
    }
    if (shiftTw) {
      const r = tweenVal(shiftTw, now);
      shift = r.v;
      if (r.done) shiftTw = null;
      else active = true;
    }
    if (zoom) {
      const dzNow = Math.max(NEAR + 1, refZ - cam.z);
      const k = REDUCED ? 1 : 1 - Math.exp(-dt / 80);
      let dzNew = dzNow * Math.pow(zoom.dzT / dzNow, k);
      const done = Math.abs(Math.log(zoom.dzT / dzNew)) < 0.002;
      if (done) dzNew = zoom.dzT;
      cam.z = refZ - dzNew;
      const m = F / dzNew;
      const { cx, cy } = centerXY();
      cam.x = zoom.wx - (zoom.mx - cx) / m;
      cam.y = zoom.wy - (zoom.my - cy) / m;
      if (done) zoom = null;
      else active = true;
    }

    applyCam(now, dt);
    if (focusT0 != null || lampBusy) active = true;
    if (renderStrings(now)) active = true;

    if (active) requestRender();
    else lastNow = 0;
  }
  function renderNow() {
    const now = performance.now();
    applyCam(now, 16.7);
    renderStrings(now);
  }

  // --- Drawing. Every style write is remembered and skipped when the
  // value hasn't changed, so a frame where little moves costs little. ---
  const nodePos: Record<string, { sx: number; sy: number; m: number; dz: number; op: number; hw: number; hh: number }> = {};
  const wc: Record<string, { t: string; o: string; z: string; pe: string }> = {};
  DATA.nodes.forEach((n) => (wc[n.id] = { t: '', o: '', z: '', pe: '' }));
  const terrCache = territories.map(() => ({ t: '', o: '' }));
  const introCache = { t: '', o: '', pe: '' };
  const lampEl = document.getElementById('mk-lamp')!;
  const lamp = { x: 0, y: 0, z: zForLvl(0), r: 900 };
  const lampCache = { t: '', o: '' };

  function applyCam(now: number, dt: number) {
    const { cx, cy } = centerXY();
    const camZ = cam.z;
    const refDz = Math.max(NEAR + 1, refZ - camZ);

    let focusK = 1;
    if (focusT0 != null) {
      const tt = focusDur <= 0 ? 1 : Math.min(1, (now - focusT0) / focusDur);
      focusK = tt < 0.5 ? 4 * tt * tt * tt : 1 - Math.pow(-2 * tt + 2, 3) / 2;
      if (tt >= 1) focusT0 = null;
    }
    readK = readFrom + ((selId ? 1 : 0) - readFrom) * focusK;

    territories.forEach((t, i) => {
      const c = terrCache[i];
      const dz = zForLvl(0) - camZ;
      let op = 0;
      if (dz > NEAR) {
        const m = F / dz;
        const sx = cx + (t.x - cam.x) * m;
        const sy = cy + (t.y - cam.y) * m;
        const tr = `translate(${sx.toFixed(1)}px,${sy.toFixed(1)}px) translate(-50%,-50%) scale(${m.toFixed(4)})`;
        if (tr !== c.t) {
          t.el.style.transform = tr;
          c.t = tr;
        }
        op = 0.075 * (1 - readK);
        if (m > 0.5) op *= Math.max(0, 1 - (m - 0.5) / 0.45);
      }
      const os = op.toFixed(3);
      if (os !== c.o) {
        t.el.style.opacity = os;
        c.o = os;
      }
    });

    let introBottom = -1e9;
    {
      const dzI = zForLvl(0) - camZ;
      let o = '0';
      let pe = 'none';
      if (dzI > NEAR) {
        const mI = F / dzI;
        const sxI = cx + (INTRO.x - cam.x) * mI;
        const syI = cy + (INTRO.y - cam.y) * mI;
        const tr = `translate(${sxI.toFixed(1)}px,${syI.toFixed(1)}px) translate(-50%,-50%) scale(${(mI * 3.2).toFixed(4)})`;
        if (tr !== introCache.t) {
          introEl.style.transform = tr;
          introCache.t = tr;
        }
        o = '1';
        pe = 'auto';
        introBottom = syI + (introH * mI * 3.2) / 2;
      }
      if (o !== introCache.o) {
        introEl.style.opacity = o;
        introCache.o = o;
      }
      if (pe !== introCache.pe) {
        introEl.style.pointerEvents = pe;
        introCache.pe = pe;
      }
    }

    DATA.nodes.forEach((n) => {
      const el = nodeEls[n.id];
      const c = wc[n.id];
      const dz = zForLvl(n.level) - camZ;
      if (dz <= NEAR) {
        if (c.o !== '0') {
          el.style.opacity = '0';
          c.o = '0';
        }
        if (c.pe !== 'none') {
          el.style.pointerEvents = 'none';
          c.pe = 'none';
        }
        delete nodePos[n.id];
        return;
      }
      const m = F / dz;
      const sx = cx + (n.x - cam.x) * m;
      const sy = cy + (n.y - cam.y) * m;
      const tr = `translate(${sx.toFixed(1)}px,${sy.toFixed(1)}px) translate(-50%,-50%) scale(${m.toFixed(4)})`;
      if (tr !== c.t) {
        el.style.transform = tr;
        c.t = tr;
      }
      const ratio = dz / refDz;
      const fade = ratio <= 1 ? 1 : Math.max(0.05, 1 - (ratio - 1) / 1.7);
      const tgtFm = focusMul(n.id);
      const fromFm = fmFrom[n.id] != null ? fmFrom[n.id] : tgtFm;
      const nfm = fromFm + (tgtFm - fromFm) * focusK;
      fm[n.id] = nfm;
      // One continuous blend from "barely there" to "fully lit" — light is
      // carried by opacity alone (no per-node filters to repaint), and a
      // lit node holds at least 0.94 even behind the focal plane.
      const dim = fade * 0.03;
      let op = dim + (Math.max(fade, 0.94) - dim) * nfm;
      const nearFade = Math.min(1, Math.max(0, (dz - NEAR) / (NEAR * 1.2)));
      op *= nearFade;
      // Keep the intro card's text clear of nodes peeking up from the map.
      if (introBottom > -1e8) {
        const top = sy - ((nodeH[n.id] || 0) * m) / 2;
        const k = (top - introBottom + 6) / 70;
        if (k < 1) op *= Math.max(0, k);
      }
      const os = op.toFixed(2);
      if (os !== c.o) {
        el.style.opacity = os;
        c.o = os;
      }
      const z = String(100 - n.level * 10 + (zBoost[n.id] || 0));
      if (z !== c.z) {
        el.style.zIndex = z;
        c.z = z;
      }
      const pe = op > 0.12 && nearFade > 0.5 ? 'auto' : 'none';
      if (pe !== c.pe) {
        el.style.pointerEvents = pe;
        c.pe = pe;
      }
      nodePos[n.id] = {
        sx,
        sy,
        m,
        dz,
        op,
        hw: ((LEVEL_CFG[n.level] || LEVEL_CFG[3]).width * m) / 2,
        hh: ((nodeH[n.id] || 0) * m) / 2,
      };
    });

    // The lamp: one soft pool of warm light behind the theme being read
    // and its sub-themes. It lives in world space (so it tracks the camera
    // exactly) and glides to the next theme when the selection changes.
    {
      let busy = false;
      if (selId) {
        const s = byId[selId];
        const pts = [s, ...s.children.map((cid) => byId[cid])];
        const tx = pts.reduce((a, p) => a + p.x, 0) / pts.length;
        const ty = pts.reduce((a, p) => a + p.y, 0) / pts.length;
        const tz = pts.reduce((a, p) => a + zForLvl(p.level), 0) / pts.length;
        const tr = Math.max(...pts.map((p) => Math.hypot(p.x - tx, p.y - ty))) + 640;
        if (readFrom < 0.02 && readK < 0.05) {
          lamp.x = tx;
          lamp.y = ty;
          lamp.z = tz;
          lamp.r = tr;
        } else {
          const k = REDUCED ? 1 : 1 - Math.exp(-dt / 170);
          lamp.x += (tx - lamp.x) * k;
          lamp.y += (ty - lamp.y) * k;
          lamp.z += (tz - lamp.z) * k;
          lamp.r += (tr - lamp.r) * k;
          busy = Math.abs(tx - lamp.x) + Math.abs(ty - lamp.y) + Math.abs(tr - lamp.r) + Math.abs(tz - lamp.z) > 1.5;
        }
      }
      lampBusy = busy;
      const dzL = lamp.z - camZ;
      let o = '0';
      if (readK > 0.004 && dzL > NEAR * 0.5) {
        const mL = F / dzL;
        const sx = cx + (lamp.x - cam.x) * mL;
        const sy = cy + (lamp.y - cam.y) * mL;
        const tr = `translate(${sx.toFixed(1)}px,${sy.toFixed(1)}px) translate(-50%,-50%) scale(${((lamp.r * mL * 2) / 1000).toFixed(4)})`;
        if (tr !== lampCache.t) {
          lampEl.style.transform = tr;
          lampCache.t = tr;
        }
        o = readK.toFixed(3);
      }
      if (o !== lampCache.o) {
        lampEl.style.opacity = o;
        lampCache.o = o;
      }
    }

    if (manualPan && !flight) {
      const inIntro = cam.y < INTRO_THRESHOLD && !selId;
      if (inIntro !== atIntro) setAtIntro(inIntro);
    }
  }

  function boxTarget(minx: number, miny: number, maxx: number, maxy: number) {
    const availW = (vpW - (panelWidth || 0)) * 0.86;
    const availH = vpH * 0.9;
    const bw = Math.max(1, maxx - minx);
    const bh = Math.max(1, maxy - miny);
    let s = Math.min(availW / bw, availH / bh);
    s = Math.max(0.1, Math.min(3.6, s));
    return { x: (minx + maxx) / 2, y: (miny + maxy) / 2, z: fitZ - F / s };
  }

  function fitOverview() {
    const pad = OVERVIEW_PAD;
    fitZ = zForLvl(0);
    flyTo(boxTarget(OVERVIEW_BB.minx - pad, OVERVIEW_BB.miny - pad, OVERVIEW_BB.maxx + pad, OVERVIEW_BB.maxy + pad), {
      refZ: zForLvl(0),
      shift: 0,
    });
  }

  function flyToIntro() {
    setAtIntro(true);
    userMoved = true;
    hideTip();
    panelWidth = 0;
    fitZ = zForLvl(0);
    startFocus();
    flyTo({ x: INTRO.x, y: INTRO.y, z: zForLvl(0) - introDz() }, { refZ: zForLvl(0), shift: 0 });
  }

  // --- Wires: hand-drawn wobble (baked into each wire's own knots) and a
  // gentle "pluck" of the selected branch. ---
  function bfs(start: string): Record<string, number> {
    const dist: Record<string, number> = { [start]: 0 };
    const q = [start];
    while (q.length) {
      const u = q.shift()!;
      (adj[u] || []).forEach((v) => {
        if (dist[v] == null) {
          dist[v] = dist[u] + 1;
          q.push(v);
        }
      });
    }
    return dist;
  }

  function pluck(id: string) {
    if (REDUCED) return;
    const dist = bfs(id);
    const now = performance.now();
    lines.forEach((o) => {
      const d = Math.min(dist[o.a] ?? 99, dist[o.b] ?? 99);
      if (d > 1) return; // only the selected branch answers, not the whole web
      const vibrating = o.amp >= 0.001;
      o.amp = o.ampBase * Math.exp(-0.5 * d);
      // a wire that is still ringing takes the new pluck at once — waiting
      // out a fresh delay used to snap it flat first
      o.delay = vibrating ? 0 : d * 60;
      o.t0 = now;
      o.dur = 2.4;
      o.decay = 1.9;
    });
    requestRender();
  }

  const lineCache = lines.map(() => ({ d: '', sw: '', so: '', hw: '', ho: '', shown: true }));
  function renderStrings(now: number): boolean {
    let vib = false;
    lines.forEach((o, i) => {
      const lc = lineCache[i];
      const A = nodePos[o.a];
      const B = nodePos[o.b];
      // A wire runs edge to edge, not centre to centre: the boxes are
      // translucent, so a wire drawn to the centre showed straight through
      // the title it was pointing at.
      let tA = 0;
      let tB = 0;
      if (A && B) {
        const fdx = Math.abs(B.sx - A.sx) || 1e-6;
        const fdy = Math.abs(B.sy - A.sy) || 1e-6;
        tA = Math.min((A.hw + 2) / fdx, (A.hh + 2) / fdy);
        tB = Math.min((B.hw + 2) / fdx, (B.hh + 2) / fdy);
      }
      if (!A || !B || tA + tB >= 0.97) {
        if (lc.shown) {
          o.vis.style.display = 'none';
          o.halo.style.display = 'none';
          o.hit.style.display = 'none';
          lc.shown = false;
        }
        return;
      }
      if (!lc.shown) {
        o.vis.style.display = '';
        o.halo.style.display = '';
        o.hit.style.display = '';
        lc.shown = true;
      }
      let decayAmp = 0;
      let tt = 0;
      if (o.amp >= 0.001) {
        const t = (now - o.t0 - o.delay) / 1000;
        if (t < 0) vib = true;
        else if (t < o.dur) {
          vib = true;
          tt = t;
          decayAmp = o.amp * Math.exp(-o.decay * t);
        } else o.amp = 0;
      }
      const ax = A.sx + (B.sx - A.sx) * tA;
      const ay = A.sy + (B.sy - A.sy) * tA;
      const bx = B.sx - (B.sx - A.sx) * tB;
      const by = B.sy - (B.sy - A.sy) * tB;
      const dx = bx - ax;
      const dy = by - ay;
      const len = Math.hypot(dx, dy) || 1;
      const px = -dy / len;
      const py = dx / len;
      const pts: [number, number][] = [[ax, ay]];
      o.knots.forEach((k) => {
        const f = k.f;
        const env = Math.sin(Math.PI * f);
        const vibOff = decayAmp * env * Math.sin(2 * Math.PI * o.freq * tt + o.phase);
        const amt = (k.off * 0.07 + vibOff) * len;
        const sagY = len * 0.01 * env;
        pts.push([ax + dx * f + px * amt, ay + dy * f + py * amt + sagY]);
      });
      pts.push([bx, by]);
      let dpath = `M${ax.toFixed(1)} ${ay.toFixed(1)}`;
      for (let p = 0; p < pts.length - 1; p++) {
        const p0 = pts[p - 1] || pts[p];
        const p1 = pts[p];
        const p2 = pts[p + 1];
        const p3 = pts[p + 2] || pts[p + 1];
        const c1x = p1[0] + (p2[0] - p0[0]) / 6;
        const c1y = p1[1] + (p2[1] - p0[1]) / 6;
        const c2x = p2[0] - (p3[0] - p1[0]) / 6;
        const c2y = p2[1] - (p3[1] - p1[1]) / 6;
        dpath += ` C${c1x.toFixed(1)} ${c1y.toFixed(1)} ${c2x.toFixed(1)} ${c2y.toFixed(1)} ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
      }
      if (dpath !== lc.d) {
        o.vis.setAttribute('d', dpath);
        o.halo.setAttribute('d', dpath);
        o.hit.setAttribute('x1', ax.toFixed(1));
        o.hit.setAttribute('y1', ay.toFixed(1));
        o.hit.setAttribute('x2', bx.toFixed(1));
        o.hit.setAttribute('y2', by.toFixed(1));
        lc.d = dpath;
      }
      const mAvg = (A.m + B.m) / 2;
      let w = Math.max(0.5, mAvg * 2.0);
      // Quiet by default: the wires are scaffolding, the themes are the
      // content. They come up only along the branch being read, or on hover.
      let op = 0.45 * Math.min(A.op, B.op);
      const fmA = fm[o.a] != null ? fm[o.a] : focusMul(o.a);
      const fmB = fm[o.b] != null ? fm[o.b] : focusMul(o.b);
      const fmMin = Math.min(fmA, fmB);
      op *= Math.max(0.2 - 0.18 * readK, fmMin);
      const lit = readK * Math.max(0, Math.min(1, (fmMin - 0.6) / 0.4));
      w *= 1 + 0.3 * lit;
      op = Math.min(1, op + 0.22 * lit);
      let haloK = 0.45 * lit;
      if (o.hover) {
        w *= 1.7;
        op = Math.min(1, op + 0.4);
        haloK = 0.55;
      }
      const sw = w.toFixed(2);
      const so = op.toFixed(2);
      const hw = (w * 3).toFixed(2);
      const ho = (op * haloK).toFixed(3);
      if (sw !== lc.sw) {
        o.vis.setAttribute('stroke-width', sw);
        lc.sw = sw;
      }
      if (so !== lc.so) {
        o.vis.setAttribute('stroke-opacity', so);
        lc.so = so;
      }
      if (hw !== lc.hw) {
        o.halo.setAttribute('stroke-width', hw);
        lc.hw = hw;
      }
      if (ho !== lc.ho) {
        o.halo.setAttribute('stroke-opacity', ho);
        lc.ho = ho;
      }
    });
    return vib;
  }

  let tipW = 0;
  let tipH = 0;
  function showTip(text: string, ev: PointerEvent) {
    tooltipEl.textContent = text;
    tooltipEl.hidden = false;
    tipW = tooltipEl.offsetWidth;
    tipH = tooltipEl.offsetHeight;
    moveTip(ev);
  }
  function moveTip(ev: PointerEvent) {
    const pad = 14;
    let x = ev.clientX + pad;
    let y = ev.clientY + pad;
    if (x + tipW > window.innerWidth - 8) x = ev.clientX - tipW - pad;
    if (y + tipH > window.innerHeight - 8) y = ev.clientY - tipH - pad;
    tooltipEl.style.left = `${x}px`;
    tooltipEl.style.top = `${y}px`;
  }
  function hideTip() {
    tooltipEl.hidden = true;
  }

  // --- Panel population ---
  function ancestorPath(id: string): ThemeNode[] {
    const path: ThemeNode[] = [];
    let p = byId[id]?.parent;
    while (p) {
      path.unshift(byId[p]);
      p = byId[p]?.parent ?? null;
    }
    return path;
  }

  function crumbLabel(n: ThemeNode) {
    return n.id === 'root' ? 'The making of' : n.label;
  }

  function escapeHtml(s: string) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  // Renders each node's content blocks in the exact order an editor set in
  // the CMS, so text and media interleave however they chose — not a fixed
  // "text then media" layout.
  const blocksWrap = document.getElementById('mk-panel-blocks')!;
  function renderBlocks(blocks: ContentBlock[]) {
    blocksWrap.innerHTML = '';
    blocks.forEach((b) => {
      if (b.type === 'text') {
        const p = document.createElement('div');
        p.className = 'mk-block-text';
        p.textContent = b.text || '';
        blocksWrap.appendChild(p);
        return;
      }
      // Every CMS field is optional, so a media block can exist with no file
      // picked yet — skip it rather than emitting an empty-src element that
      // renders as a broken image / dead player.
      if (!b.file) return;
      const wrap = document.createElement('div');
      wrap.className = 'mk-block-media';
      const src = b.file;
      if (b.type === 'image') {
        const img = document.createElement('img');
        img.src = src;
        img.alt = b.caption || '';
        img.loading = 'lazy';
        wrap.appendChild(img);
      } else if (b.type === 'video') {
        const video = document.createElement('video');
        video.src = src;
        video.controls = true;
        wrap.appendChild(video);
      } else if (b.type === 'audio') {
        const audioWrap = document.createElement('div');
        audioWrap.className = 'mk-block-audio-wrap';
        const audio = document.createElement('audio');
        audio.src = src;
        audio.controls = true;
        audioWrap.appendChild(audio);
        wrap.appendChild(audioWrap);
      }
      if (b.caption) {
        const cap = document.createElement('div');
        cap.className = 'mk-block-caption';
        cap.textContent = b.caption;
        wrap.appendChild(cap);
      }
      blocksWrap.appendChild(wrap);
    });
  }

  function populatePanel(n: ThemeNode) {
    const id = n.id;
    const crumbWrap = document.getElementById('mk-breadcrumb')!;
    crumbWrap.innerHTML = '';
    ancestorPath(id).forEach((p) => {
      const span = document.createElement('span');
      span.className = 'mk-crumb';
      span.innerHTML = `<span class="mk-crumb-label">${escapeHtml(crumbLabel(p))}</span><span class="mk-crumb-sep">/</span>`;
      span.addEventListener('click', () => select(p.id));
      crumbWrap.appendChild(span);
    });
    const cur = document.createElement('span');
    cur.className = 'mk-crumb-label';
    cur.style.color = n.color;
    cur.textContent = crumbLabel(n);
    crumbWrap.appendChild(cur);

    (document.getElementById('mk-panel-title') as HTMLElement).textContent = crumbLabel(n);

    const authorsEl = document.getElementById('mk-panel-authors')!;
    if (n.authors) {
      authorsEl.hidden = false;
      authorsEl.textContent = `DRAFT · ${n.authors}`;
    } else {
      authorsEl.hidden = true;
    }

    (document.getElementById('mk-panel-rule') as HTMLElement).style.background = n.color;
    renderBlocks(n.blocks);

    const qWrap = document.getElementById('mk-panel-questions')!;
    const qList = document.getElementById('mk-panel-questions-list')!;
    qList.innerHTML = '';
    if (n.questions.length) {
      qWrap.hidden = false;
      n.questions.forEach((q) => {
        const d = document.createElement('div');
        d.className = 'mk-question';
        d.style.borderColor = n.color;
        d.textContent = q;
        qList.appendChild(d);
      });
    } else {
      qWrap.hidden = true;
    }

    const cWrap = document.getElementById('mk-panel-children')!;
    const cList = document.getElementById('mk-panel-children-list')!;
    cList.innerHTML = '';
    if (n.children.length) {
      cWrap.hidden = false;
      n.children.forEach((cid) => {
        const c = byId[cid];
        const row = document.createElement('div');
        row.className = 'mk-child-row';
        row.innerHTML = `<span class="mk-child-num">${escapeHtml(c.number)}</span><span class="mk-child-label">${escapeHtml(c.label)}</span>`;
        row.addEventListener('click', () => select(cid));
        cList.appendChild(row);
      });
    } else {
      cWrap.hidden = true;
    }

    const connWrap = document.getElementById('mk-panel-connections')!;
    const connList = document.getElementById('mk-panel-connections-list')!;
    connList.innerHTML = '';
    const conns = DATA.links
      .filter((l) => l.from === id || l.to === id)
      .map((l) => (l.from === id ? { other: byId[l.to], note: l.note } : { other: byId[l.from], note: l.note }));
    if (conns.length) {
      connWrap.hidden = false;
      conns.forEach(({ other, note }) => {
        const row = document.createElement('div');
        row.className = 'mk-conn';
        row.innerHTML = `<div class="mk-conn-head"><span class="mk-conn-num">${escapeHtml(other.number)} →</span><span class="mk-conn-label">${escapeHtml(other.label)}</span></div><div class="mk-conn-text">${escapeHtml(note)}</div>`;
        row.addEventListener('click', () => select(other.id));
        connList.appendChild(row);
      });
    } else {
      connWrap.hidden = true;
    }

    const parentWrap = document.getElementById('mk-panel-parent')!;
    parentWrap.innerHTML = '';
    if (n.parent) {
      parentWrap.hidden = false;
      const p = byId[n.parent];
      const link = document.createElement('span');
      link.className = 'mk-parent-link';
      link.textContent = `← Part of ${p.number} · ${crumbLabel(p)}`;
      link.addEventListener('click', () => select(p.id));
      parentWrap.appendChild(link);
    } else {
      parentWrap.hidden = true;
    }
  }

  // The panel slides in/out (CSS transition on .is-open) rather than
  // popping, and when it is already open and the theme changes, the old
  // text fades out before the new text fades in at the top of the scroll.
  let swapToken = 0;
  function showPanelFor(n: ThemeNode, prev: string | null) {
    const wasOpen = panel.classList.contains('is-open');
    document.documentElement.classList.add('mk-reading');
    panel.classList.add('is-open');
    const token = ++swapToken;
    if (wasOpen && prev && prev !== n.id && !REDUCED) {
      panel.classList.add('is-swapping');
      window.setTimeout(() => {
        if (token !== swapToken) return;
        populatePanel(n);
        panel.scrollTop = 0;
        panel.classList.remove('is-swapping');
      }, 150);
    } else {
      populatePanel(n);
      panel.scrollTop = 0;
      panel.classList.remove('is-swapping');
    }
  }
  function hidePanel() {
    ++swapToken;
    document.documentElement.classList.remove('mk-reading');
    panel.classList.remove('is-open', 'is-swapping');
  }

  function markSelected(prev: string | null) {
    if (prev && nodeEls[prev]) nodeEls[prev].classList.remove('is-selected');
    if (selId && nodeEls[selId]) nodeEls[selId].classList.add('is-selected');
  }

  function select(id: string) {
    const n = byId[id];
    if (!n) return;
    const prev = selId;
    selId = id;
    userMoved = true;
    hideTip();
    panelWidth = panelW();
    nudgeOn = false;
    updateNudge();
    panelHintEl.hidden = panelHintSeen;
    if (!panelHintSeen) panelHintShownThisSelection = true;
    fitZ = zForLvl(n.level);
    markSelected(prev);
    startFocus();
    pluck(id);
    showPanelFor(n, prev);
    setAtIntro(false);
    toIntroBtn.hidden = false;

    const kids = n.children.map((cid) => byId[cid]);
    const pts = [n, ...kids];
    const minx = Math.min(...pts.map((p) => p.x));
    const miny = Math.min(...pts.map((p) => p.y));
    const maxx = Math.max(...pts.map((p) => p.x));
    const maxy = Math.max(...pts.map((p) => p.y));
    const pad = kids.length ? 360 : 300;
    flyTo(boxTarget(minx - pad, miny - pad, maxx + pad, maxy + pad), { refZ: zForLvl(n.level), shift: panelWidth });
  }

  // Drops the selection state without starting any camera move, so callers
  // decide where to fly (the overview, or the intro) exactly once.
  function clearSelection() {
    const prev = selId;
    selId = null;
    if (panelHintShownThisSelection && !panelHintSeen) {
      try {
        localStorage.setItem('pa-mk-hint-panel', '1');
      } catch (e) {}
      panelHintSeen = true;
    }
    hidePanel();
    panelWidth = 0;
    markSelected(prev);
  }

  function deselect() {
    clearSelection();
    startFocus();
    setAtIntro(false);
    fitOverview();
  }

  // --- Pan / zoom interaction ---
  // Click-to-select is handled here (not via a plain `click` listener on each
  // node/link) because `setPointerCapture` below redirects the click that
  // follows a captured pointer sequence to the capturing element, so a
  // listener on the node itself never fires.
  let drag: {
    x: number;
    y: number;
    sx: number;
    sy: number;
    moved: boolean;
    target: EventTarget | null;
    samples: { t: number; x: number; y: number }[];
  } | null = null;

  // Belt and braces alongside the viewport's user-select:none — if any text
  // does end up selected (e.g. selected in the panel, drag started over the
  // map), never let the browser turn the gesture into a native text drag.
  viewport.addEventListener('dragstart', (e) => e.preventDefault());

  viewport.addEventListener('pointerdown', (e) => {
    if (e.button !== 0) return;
    // touching the map stops whatever it was coasting through
    inertia = null;
    zoom = null;
    drag = { x: e.clientX, y: e.clientY, sx: e.clientX, sy: e.clientY, moved: false, target: e.target, samples: [] };
    viewport.setPointerCapture(e.pointerId);
    viewport.classList.add('is-dragging');
  });
  viewport.addEventListener('pointermove', (e) => {
    if (!drag) return;
    if (!drag.moved) {
      // Under 5px it's a click, not a pan — a slightly unsteady press no
      // longer nudges the map or kills a flight in progress.
      if (Math.abs(e.clientX - drag.sx) + Math.abs(e.clientY - drag.sy) <= 5) return;
      drag.moved = true;
      userMoved = true;
      manualPan = true;
      flight = null;
      hideTip();
      drag.x = e.clientX;
      drag.y = e.clientY;
    }
    const mRef = F / Math.max(1, refZ - cam.z);
    cam.x -= (e.clientX - drag.x) / mRef;
    cam.y -= (e.clientY - drag.y) / mRef;
    drag.x = e.clientX;
    drag.y = e.clientY;
    drag.samples.push({ t: e.timeStamp, x: e.clientX, y: e.clientY });
    while (drag.samples.length > 2 && e.timeStamp - drag.samples[0].t > 100) drag.samples.shift();
    requestRender();
  });
  function endDrag(e?: PointerEvent) {
    viewport.classList.remove('is-dragging');
    const d = drag;
    drag = null;
    if (!d) return { wasClick: false, target: null as EventTarget | null };
    if (d.moved && e && !REDUCED && d.samples.length >= 2) {
      // Carry the hand's speed over the last ~100ms into a short glide.
      const a = d.samples[0];
      const b = d.samples[d.samples.length - 1];
      const span = b.t - a.t;
      if (span > 16 && e.timeStamp - b.t < 70) {
        const vx = (b.x - a.x) / span;
        const vy = (b.y - a.y) / span;
        if (Math.hypot(vx, vy) > 0.12) {
          inertia = { vx, vy };
          requestRender();
        }
      }
    }
    return { wasClick: !d.moved, target: d.moved ? null : d.target };
  }
  viewport.addEventListener('pointerup', (e) => {
    const { wasClick, target } = endDrag(e);
    if (!wasClick) return;
    const el = target as HTMLElement | null;
    if (el?.closest('.mk-link-hit')) return;
    // The intro's enter button lives inside #mk-viewport (so it can be
    // camera-projected like a node) — pointer capture above redirects the
    // native click away from it for real mouse/touch input, so route it the
    // same way node selection is routed.
    if (el?.closest('#mk-intro-close')) {
      userMoved = true;
      deselect();
      return;
    }
    const nodeEl = el?.closest<HTMLElement>('.mk-node');
    if (nodeEl?.dataset.id) select(nodeEl.dataset.id);
    else if (selId) deselect();
  });
  viewport.addEventListener('pointercancel', () => endDrag());

  let exitT = 0;
  let exitAcc = 0;
  viewport.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      // Normalise across devices: lines and pages into pixels, so a mouse
      // notch and a trackpad swipe both zoom in proportion to how far the
      // hand actually moved (the old fixed step per event made trackpads
      // rocket and mice crawl).
      let d = e.deltaY;
      if (e.deltaMode === 1) d *= 16;
      else if (e.deltaMode === 2) d *= vpH;
      const dzCur = zoom ? zoom.dzT : Math.max(NEAR + 1, refZ - cam.z);

      // Pulling back past the overview edge flies back up to the intro.
      if (d > 0 && !selId && !atIntro && dzCur >= maxDz() * 0.98) {
        const now = performance.now();
        if (!exitT || now - exitT > 900) exitAcc = 0;
        exitT = now;
        exitAcc += d;
        if (exitAcc > 260) {
          exitAcc = 0;
          flyToIntro();
        }
        return;
      }

      d = Math.max(-240, Math.min(240, d));
      // pinch (ctrlKey) reports small deltas for a deliberate gesture
      const factor = Math.pow(2, -d * 0.002 * (e.ctrlKey ? 10 : 1));
      zoomAt(e.clientX - vpLeft, e.clientY - vpTop, factor);
    },
    { passive: false },
  );

  // --- Header / intro controls ---
  document.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const act = btn.dataset.act;
      if (act === 'overview' || act === 'close') deselect();
      else if (act === 'zoom-in') zoomBy(1.35);
      else if (act === 'zoom-out') zoomBy(0.74);
    });
  });

  document.getElementById('mk-intro-close')!.addEventListener('click', () => {
    userMoved = true;
    deselect();
  });
  toIntroBtn.addEventListener('click', () => {
    if (selId) clearSelection();
    flyToIntro();
  });

  // Keyboard: Esc closes; while reading, the arrows walk the tree (left /
  // right between sibling themes, up to the parent, down into the first
  // sub-theme); + and − zoom.
  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const t = e.target as HTMLElement | null;
    if (t && /^(INPUT|TEXTAREA|SELECT|AUDIO|VIDEO)$/.test(t.tagName)) return;
    if (e.key === 'Escape') {
      if (selId) deselect();
      return;
    }
    if (e.key === '+' || e.key === '=') {
      e.preventDefault();
      zoomBy(1.35);
      return;
    }
    if (e.key === '-' || e.key === '_') {
      e.preventDefault();
      zoomBy(0.74);
      return;
    }
    if (!selId) return;
    const n = byId[selId];
    let to: string | null | undefined = null;
    if (e.key === 'ArrowUp') to = n.parent;
    else if (e.key === 'ArrowDown') to = n.children[0];
    else if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
      const sibs = n.parent ? byId[n.parent].children : [];
      to = sibs[sibs.indexOf(n.id) + (e.key === 'ArrowRight' ? 1 : -1)];
    }
    if (to && byId[to]) {
      e.preventDefault();
      select(to);
    }
  });

  // --- Init ---
  function measureHeader() {
    const header = document.querySelector<HTMLElement>('.hd-header');
    if (header) document.documentElement.style.setProperty('--mk-header-h', `${header.offsetHeight}px`);
  }

  let resizeRaf = 0;
  window.addEventListener('resize', () => {
    if (resizeRaf) return;
    resizeRaf = requestAnimationFrame(() => {
      resizeRaf = 0;
      measureHeader();
      measure();
      if (selId) {
        panelWidth = panelW();
        shift = panelWidth;
        shiftTw = null;
      }
      requestRender();
    });
  });

  // Seat the camera at the fitted overview distance *before* the first
  // paint. cam.z starts at 0, i.e. the camera sitting almost on top of the
  // intro card (dz = 340, so ~12x scale) — drawing even one frame from
  // there shows the intro text hugely magnified before it settles. Measure
  // the header first: introDz() fits to the viewport, whose height
  // depends on the --mk-header-h that measureHeader() sets.
  measureHeader();
  measure();
  cam.z = zForLvl(0) - introDz();
  renderNow();
  updateNudge();

  // Camera starts on the intro; a short settle loop re-fits it as the
  // viewport's real size becomes available (fonts/layout can shift it late,
  // e.g. once web fonts finish loading and the header re-wraps). Redraws are
  // cheap here: unchanged styles are skipped, so a tick where nothing moved
  // writes nothing.
  let fitTries = 0;
  function initFit() {
    if (userMoved) return;
    measureHeader();
    measure();
    refZ = zForLvl(0);
    fitZ = zForLvl(0);
    cam.x = INTRO.x;
    cam.y = INTRO.y;
    cam.z = zForLvl(0) - introDz();
    requestRender();
    if (++fitTries < 22) window.setTimeout(initFit, 90);
  }
  window.setTimeout(initFit, 30);
  if (document.fonts?.ready) {
    document.fonts.ready.then(() => {
      measure();
      requestRender();
    });
  }
  } // end initMap()
</script>
