---
import BaseLayout from '../layouts/BaseLayout.astro';
import regionColors from '../../content/themes/region-colors.json';
import crossLinksFile from '../../content/themes/cross-links.json';
import { buildThemeMap } from '../lib/themes';
import type { RawThemeNode, RawThemesData } from '../lib/themes';

// One file per theme node (content/themes/nodes/*.json) so editors can add,
// rename, and re-nest themes as independent CMS entries — the tree shape
// comes entirely from each node's own `parent` field, not file order.
const nodeFiles = import.meta.glob<RawThemeNode>('../../content/themes/nodes/*.json', { eager: true, import: 'default' });
const themesRaw: RawThemesData = {
  regionColors,
  nodes: Object.values(nodeFiles),
  crossLinks: crossLinksFile.links,
};

const themeMap = buildThemeMap(themesRaw);
const regions = themeMap.nodes.filter((n) => n.level === 0);

// --- Phone fallback: the pan/zoom map is a pointer interface, so under
// 680px the page swaps to a hierarchical browser (one node per "screen",
// drill down through sub-themes, hash-routed so the browser back button
// works). Everything below is rendered statically from the same themeMap.
const mkmById = Object.fromEntries(themeMap.nodes.map((n) => [n.id, n]));
const mkmNumKey = (num: string) => num.split('.').map((s) => Number(s) || 0);
const mkmKids = (id: string) =>
  themeMap.nodes
    .filter((n) => n.parent === id)
    .sort((a, b) => {
      const ka = mkmNumKey(a.number);
      const kb = mkmNumKey(b.number);
      for (let i = 0; i < Math.max(ka.length, kb.length); i++) {
        const d = (ka[i] ?? -1) - (kb[i] ?? -1);
        if (d) return d;
      }
      return 0;
    });
const mkmCrumbs = (n: (typeof themeMap.nodes)[number]) => {
  const chain = [];
  let cur = n.parent ? mkmById[n.parent] : undefined;
  while (cur) {
    chain.unshift(cur);
    cur = cur.parent ? mkmById[cur.parent] : undefined;
  }
  return chain;
};
const mkmConns = (id: string) =>
  themeMap.links
    .filter((l) => l.from === id || l.to === id)
    .map((l) => ({ other: mkmById[l.from === id ? l.to : l.from], note: l.note }))
    .filter((c) => c.other);
---

<BaseLayout
  title="The Making Of"
  active="making-of"
  fullscreen
  description="A pannable, zoomable map of the themes behind the Polyphonic Archive podcast."
>
  <Fragment slot="header-extra">
    <div class="mk-header-controls">
      <button type="button" class="mk-btn" data-act="overview">Overview</button>
      <button type="button" class="mk-btn mk-btn-square" data-act="zoom-out" aria-label="Zoom out">−</button>
      <button type="button" class="mk-btn mk-btn-square" data-act="zoom-in" aria-label="Zoom in">+</button>
    </div>
  </Fragment>

  <!-- Runs during parsing, before the intro card below is painted. The map
       script is a bundled module and therefore deferred, so between first
       paint and that script running the intro would otherwise show
       unpositioned — full size at the top-left corner, over the masthead —
       which reads as a flash of stray content on the way into the page.
       Gating on a class set here (rather than defaulting .mk-intro to
       opacity:0) keeps the card visible when JS never arrives at all. -->
  <script is:inline>document.documentElement.classList.add('mk-js');</script>

  <div id="mk-viewport">
    <div id="mk-bg"></div>
    <svg id="mk-lines" xmlns="http://www.w3.org/2000/svg"></svg>
    <div id="mk-terr"></div>
    <div id="mk-lamp"></div>
    <div id="mk-nodes">
      <div id="mk-intro" class="mk-intro">
        <div class="mk-eyebrow mk-intro-eyebrow">Polyphonic Archive · the making-of</div>
        <div class="mk-intro-title">A map of the themes behind the podcast</div>
        <div class="mk-intro-body">
          Four regions grow from one centre —
          {
            regions.map((r, i) => (
              <>
                <span style={`color:${r.color};`}>{r.label}</span>
                {i < regions.length - 2 ? ', ' : i === regions.length - 2 ? ' and ' : ''}
              </>
            ))
          }
          . Themes light up as you move through them; wires show what belongs where, and each theme's reading panel surfaces what it connects across.
        </div>
        <div class="mk-eyebrow mk-intro-hint">drag to pan · scroll to zoom · press a theme to read</div>
        <div class="mk-eyebrow mk-intro-press">press here to begin</div>
        <button type="button" id="mk-intro-close" class="mk-intro-enter" aria-label="Enter the map">↓</button>
        <div class="mk-eyebrow mk-intro-foot">the map lies below ↓ · you can always drag your way back up here</div>
        <div class="mk-intro-credit">
          Some of the texts and quotations in this section are drawn from a forthcoming publication: Sharon, T., &
          Bueno de Mesquita, N. (Eds.) (forthcoming). Polyphonic Archive: Pluralism as Practice and Modes of
          Translation. Amsterdam University of the Arts.
        </div>
      </div>
    </div>
  </div>

  <button type="button" id="mk-to-intro" class="mk-pill" hidden>
    <span class="mk-pill-arrow">↑</span><span>Intro</span>
  </button>

  <div id="mk-nudge" class="mk-nudge" hidden>Press a lit theme to read more</div>

  <div id="mk-tooltip" class="mk-tooltip" hidden></div>

  <div id="mk-spill" aria-hidden="true"></div>

  <aside id="mk-panel" class="mk-panel">
    <div class="mk-panel-top">
      <div id="mk-breadcrumb" class="mk-breadcrumb"></div>
      <button type="button" class="mk-btn" data-act="close">Close ×</button>
    </div>
    <div id="mk-panel-hint" class="mk-panel-hint" hidden>The path above shows where you are — press a step to go back out, or a sub-theme below to go deeper.</div>
    <h2 id="mk-panel-title" class="mk-panel-title"></h2>
    <div id="mk-panel-authors" class="mk-panel-authors" hidden></div>
    <div id="mk-panel-rule" class="mk-panel-rule"></div>
    <div id="mk-panel-blocks" class="mk-panel-blocks"></div>
    <div id="mk-panel-questions" class="mk-panel-questions" hidden>
      <div class="mk-eyebrow mk-panel-label">Open questions</div>
      <div id="mk-panel-questions-list"></div>
    </div>
    <div id="mk-panel-children" class="mk-panel-children" hidden>
      <div class="mk-eyebrow mk-panel-label">Sub-themes</div>
      <div id="mk-panel-children-list"></div>
    </div>
    <div id="mk-panel-connections" class="mk-panel-connections" hidden>
      <div class="mk-eyebrow mk-panel-label mk-panel-label-teal">Connections</div>
      <div id="mk-panel-connections-list"></div>
    </div>
    <div id="mk-panel-parent" class="mk-panel-parent" hidden></div>
  </aside>

  <!-- Phone version: one node per screen, drilled into via the sub-theme
       rows below each text. Hash-routed (#t2-2) so the browser's back
       button walks back up the tree. Hidden on desktop; the map and its
       whole script are skipped on phones (see the media-query guard at the
       top of the map script). -->
  <div id="mkm">
    {
      themeMap.nodes.map((n) => (
        <article class="mkm-node" id={`mkm-${n.id}`} hidden>
          {n.level === -1 ? (
            <div class="mkm-eyebrow">Polyphonic Archive · the making-of</div>
          ) : (
            <nav class="mkm-crumbs" aria-label="You are here">
              {mkmCrumbs(n).map((a) => (
                <a href={`#${a.id}`}>{a.level === -1 ? 'The making of' : a.label}</a>
              ))}
            </nav>
          )}

          <h2 class="mkm-title">{n.level >= 1 ? `${n.number} — ${n.label}` : n.label}</h2>
          <div class="mkm-rule" style={`background:${n.color}`} />

          <div class="mkm-blocks">
            {n.blocks.map((b) =>
              b.type === 'text' && b.text ? (
                <p class="mkm-text">{b.text}</p>
              ) : b.type === 'image' && b.file ? (
                <figure class="mkm-media">
                  <img src={b.file} alt={b.caption || ''} loading="lazy" />
                  {b.caption && <figcaption>{b.caption}</figcaption>}
                </figure>
              ) : b.type === 'audio' && b.file ? (
                <figure class="mkm-media mkm-media-audio">
                  <audio controls preload="none" src={b.file} />
                  {b.caption && <figcaption>{b.caption}</figcaption>}
                </figure>
              ) : b.type === 'video' && b.file ? (
                <figure class="mkm-media">
                  <video controls playsinline preload="metadata" src={b.file} />
                  {b.caption && <figcaption>{b.caption}</figcaption>}
                </figure>
              ) : null,
            )}
          </div>

          {mkmKids(n.id).length > 0 && (
            <div class="mkm-section">
              <div class="mkm-label">{n.level === -1 ? 'Themes' : 'Sub-themes'}</div>
              {mkmKids(n.id).map((c) => (
                <a class="mkm-row" href={`#${c.id}`} style={`--c:${c.color}`}>
                  {c.level >= 1 && <span class="mkm-row-num">{c.number}</span>}
                  <span class="mkm-row-label">{c.label}</span>
                  <span class="mkm-row-arrow">→</span>
                </a>
              ))}
            </div>
          )}

          {mkmConns(n.id).length > 0 && (
            <div class="mkm-section">
              <div class="mkm-label mkm-label-teal">Connections</div>
              {mkmConns(n.id).map((c) => (
                <a class="mkm-conn" href={`#${c.other.id}`}>
                  <span class="mkm-conn-note">{c.note}</span>
                  <span class="mkm-conn-target" style={`color:${c.other.color}`}>
                    {c.other.level >= 1 ? `${c.other.number} — ` : ''}{c.other.label} →
                  </span>
                </a>
              ))}
            </div>
          )}

          {n.parent && (
            <a class="mkm-back" href={`#${n.parent}`}>
              ← Back to {n.parent === 'root' ? 'the overview' : mkmById[n.parent].label}
            </a>
          )}
        </article>
      ))
    }
  </div>

  <script is:inline>
    // Router for the phone version: show exactly one .mkm-node, chosen by
    // the URL hash (#t2-2), falling back to the root. Runs on any viewport
    // (it only touches elements that are display:none on desktop), so no
    // media-query coordination is needed here.
    (function () {
      var views = Array.prototype.slice.call(document.querySelectorAll('.mkm-node'));
      if (!views.length) return;
      // Belt and braces for the scroll unlock: the stylesheet override of
      // the map's fullscreen page freeze exists, but enforce it inline too
      // so no cascade-order or browser quirk can leave phones unscrollable.
      if (window.matchMedia('(max-width: 680px)').matches) {
        var pr = document.querySelector('.page-root');
        if (pr) {
          pr.style.setProperty('height', 'auto', 'important');
          pr.style.setProperty('min-height', '100vh', 'important');
          pr.style.setProperty('overflow', 'visible', 'important');
        }
      }
      function show() {
        var id = (location.hash || '').replace(/^#/, '') || 'root';
        var target = document.getElementById('mkm-' + id) || document.getElementById('mkm-root');
        views.forEach(function (v) {
          v.hidden = v !== target;
        });
        window.scrollTo(0, 0);
      }
      window.addEventListener('hashchange', show);
      show();
    })();
  </script>

  <script
    type="application/json"
    id="mk-data"
    set:html={JSON.stringify({ nodes: themeMap.nodes, links: themeMap.links, regionColors: themeMap.regionColors, bbox: themeMap.bbox })}
  />
</BaseLayout>

<style>
  #mk-viewport {
    position: fixed;
    left: 0;
    right: 0;
    top: var(--mk-header-h, 72px);
    bottom: 0;
    overflow: hidden;
    background: #120f18;
    touch-action: none;
    cursor: grab;
    /* The viewport is a drag-to-pan surface: without this, a pan gesture
       selects the intro/node text, and the next drag picks that selection
       up as a native browser drag-ghost — a trail of duplicate text
       chasing the cursor. (The reading panel sits outside the viewport,
       so its text stays selectable.) */
    user-select: none;
    -webkit-user-select: none;
  }

  #mk-viewport.is-dragging {
    cursor: grabbing;
  }

  /* A static backdrop, kept to two soft glows rather than four so there's
     less for the browser to recomposite behind the constantly-repositioned
     nodes/lines/territories on every repaint. */
  #mk-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      radial-gradient(ellipse 1100px 750px at 30% 28%, rgba(122, 152, 214, 0.07), transparent 68%),
      radial-gradient(ellipse 1100px 750px at 70% 78%, rgba(210, 130, 136, 0.07), transparent 68%);
  }

  #mk-lines {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 5;
  }

  #mk-terr {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
  }

  /* The reading lamp: one warm pool of light behind the selected theme and
     its sub-themes, positioned and faded by the camera code. A single
     element instead of stacked drop-shadow filters on every node. */
  #mk-lamp {
    position: absolute;
    left: 0;
    top: 0;
    width: 1000px;
    height: 1000px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 4;
    opacity: 0;
    background: radial-gradient(
      closest-side,
      rgba(255, 214, 150, 0.2),
      rgba(255, 200, 120, 0.09) 42%,
      rgba(255, 196, 110, 0) 100%
    );
    will-change: transform, opacity;
  }

  #mk-nodes {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 10;
  }

  :global(.mk-node) {
    position: absolute;
    left: 0;
    top: 0;
    box-sizing: border-box;
    cursor: pointer;
    text-align: center;
    font-family: 'Courier Prime', 'Courier New', monospace;
  }

  :global(.mk-node:hover .mk-node-title) {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  :global(.mk-node:hover) {
    filter: brightness(1.14);
  }

  :global(.mk-node.is-selected) {
    outline: 2px solid #f4cb7a;
    outline-offset: 3px;
  }

  :global(.mk-node-title) {
    font-weight: 400;
    color: #f2eee6;
    line-height: 1.15;
  }

  :global(.mk-node-num) {
    font-family: 'Courier Prime', monospace;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  :global(.mk-node-sub) {
    letter-spacing: 0.05em;
    color: #9a938a;
  }

  :global(.mk-link) {
    fill: none;
    stroke-linecap: round;
    pointer-events: none;
  }

  :global(.mk-link-hit) {
    stroke: #000;
    stroke-opacity: 0;
    stroke-width: 16;
    pointer-events: stroke;
    cursor: default;
  }

  @keyframes mkfadein {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  :global(.mk-terr-label) {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    font-family: 'Courier Prime', monospace;
    font-weight: 700;
    letter-spacing: 0.1em;
    font-size: 118px;
  }

  .mk-tooltip {
    position: fixed;
    z-index: 60;
    pointer-events: none;
    max-width: 268px;
    background: #2a2632;
    border: 1px solid rgba(230, 225, 217, 0.3);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.2), 0 10px 28px rgba(0, 0, 0, 0.4);
    padding: 11px 14px;
    font-family: 'Courier Prime', monospace;
    font-size: 13px;
    line-height: 1.5;
    color: #e6e1d9;
    animation: mkfadein 0.14s ease;
  }

  .mk-tooltip[hidden] {
    display: none;
  }

  .mk-nudge {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 41;
    pointer-events: none;
    font-family: 'Courier Prime', monospace;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: #48c6a8;
    background: rgba(18, 15, 24, 0.82);
    border: 1px solid rgba(72, 198, 168, 0.28);
    padding: 7px 14px;
    animation: mkfadein 0.5s ease;
  }

  .mk-nudge[hidden] {
    display: none;
  }

  .mk-header-controls {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }

  .mk-btn {
    font-family: 'Courier Prime', monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
    line-height: 1;
    padding: 8px 13px;
    border: 1px solid rgba(230, 225, 217, 0.5);
    background: transparent;
    color: #e6e1d9;
    cursor: pointer;
  }

  .mk-btn:hover {
    border-color: #48c6a8;
    color: #48c6a8;
  }

  .mk-btn-square {
    font-size: 16px;
    width: 33px;
    height: 33px;
    padding: 0;
  }

  .mk-pill {
    position: fixed;
    top: calc(var(--mk-header-h, 72px) + 18px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 40;
    font-family: 'Courier Prime', monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
    padding: 7px 12px;
    border: 1px solid rgba(230, 225, 217, 0.35);
    background: rgba(26, 23, 32, 0.85);
    color: #9a938a;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .mk-pill:hover {
    border-color: #f4cb7a;
    color: #f4cb7a;
  }

  .mk-pill[hidden] {
    display: none;
  }

  .mk-pill-arrow {
    font-size: 13px;
  }

  .mk-eyebrow {
    font-family: 'Courier Prime', monospace;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 400;
  }

  .mk-intro {
    position: absolute;
    left: 0;
    top: 0;
    width: 860px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 26px;
    text-align: center;
    z-index: 15;
    will-change: transform, opacity;
  }

  /* Hidden only until the camera's first applyCam() gives it a real
     transform and opacity — see the inline script above the viewport. */
  :global(html.mk-js) .mk-intro {
    opacity: 0;
  }

  .mk-intro-eyebrow {
    font-size: 13px;
    color: #f4cb7a;
  }

  .mk-intro-title {
    font-weight: 700;
    font-size: clamp(1.6rem, 4vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #f2eee6;
    max-width: 800px;
  }

  .mk-intro-body {
    font-size: 17px;
    line-height: 1.75;
    color: #b9b2a7;
    max-width: 600px;
  }

  .mk-intro-hint {
    font-size: 12px;
    color: #9a938a;
  }

  .mk-intro-press {
    font-size: 12px;
    color: #f4cb7a;
    margin-bottom: 2px;
  }

  .mk-intro-enter {
    font-family: 'Courier Prime', monospace;
    margin-top: 6px;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    border: 2px solid #f4cb7a;
    background: transparent;
    color: #f4cb7a;
    font-size: 32px;
    line-height: 1;
    cursor: pointer;
    /* a slow breathing glow, so the one pressable thing on this screen
       reads as pressable without anyone having to be told twice */
    animation: mk-enter-pulse 2.6s ease-in-out infinite;
  }

  @keyframes mk-enter-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(244, 203, 122, 0);
      background: transparent;
    }
    50% {
      box-shadow: 0 0 22px 2px rgba(244, 203, 122, 0.28);
      background: rgba(244, 203, 122, 0.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mk-intro-enter {
      animation: none;
      background: rgba(244, 203, 122, 0.08);
    }
  }

  .mk-intro-enter:hover {
    background: rgba(244, 203, 122, 0.16);
    animation: none;
    box-shadow: 0 0 22px 2px rgba(244, 203, 122, 0.32);
  }

  .mk-intro-foot {
    font-size: 11px;
    color: #655e55;
  }

  .mk-intro-credit {
    margin-top: 1.6rem;
    max-width: 620px;
    font-size: 11.5px;
    font-style: italic;
    line-height: 1.7;
    color: rgba(224, 219, 212, 0.38);
    text-wrap: pretty;
    /* the card floats over the map — keep the credit readable when a dim
       node happens to sit behind its last lines */
    text-shadow:
      0 0 6px rgba(18, 15, 24, 0.95),
      0 0 14px rgba(18, 15, 24, 0.85);
  }

  .mk-panel {
    position: fixed;
    top: var(--mk-header-h, 72px);
    right: 0;
    bottom: 0;
    width: min(452px, 42vw);
    z-index: 45;
    /* the brightest surface on screen while reading: the map goes dark
       around it, this stays lit */
    background: #2b2735;
    border-left: 1px solid rgba(255, 224, 170, 0.16);
    padding: 26px 28px 44px;
    overflow-y: auto;
    box-sizing: border-box;
    font-family: 'Courier Prime', monospace;
    color: #ece7df;
    /* closed: parked just off the right edge (not display:none, so it can
       slide rather than pop) */
    transform: translateX(104%);
    visibility: hidden;
    transition:
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 420ms;
  }

  .mk-panel.is-open {
    transform: none;
    visibility: visible;
    transition:
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s;
  }

  /* text swap between themes: out, replace, back in */
  .mk-panel > * {
    transition: opacity 150ms ease;
  }

  .mk-panel.is-swapping > * {
    opacity: 0;
  }

  /* Where the map meets the panel: a soft falloff into shadow instead of
     a hard edge, so the map recedes toward the text. */
  #mk-spill {
    position: fixed;
    top: var(--mk-header-h, 72px);
    bottom: 0;
    right: min(452px, 42vw);
    width: 150px;
    z-index: 44;
    pointer-events: none;
    background: linear-gradient(to right, rgba(18, 15, 24, 0), rgba(18, 15, 24, 0.55));
    opacity: 0;
    transition: opacity 420ms ease;
  }

  :global(html.mk-reading) #mk-spill {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .mk-panel,
    .mk-panel.is-open,
    .mk-panel > *,
    #mk-spill {
      transition: none;
    }
  }

  .mk-panel-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .mk-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    row-gap: 5px;
    min-width: 0;
    padding-top: 4px;
