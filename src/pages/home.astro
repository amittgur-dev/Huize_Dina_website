---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { renderInline } from '../lib/markup';
import home from '../../content/pages/home.json';
---

<BaseLayout title="Home" active="home">
  <Hero title={home.title} eyebrow={home.eyebrow} />

  <div class="inner">
    {
      home.blocks.map((block: any) =>
        block.type === 'text' ? (
          <div class={`text-block ts-${block.size || 'normal'}`} set:html={renderInline(block.text)} />
        ) : block.type === 'pair' ? (
          block.left?.file || block.right?.file ? (
            <div class={`image-pair ${block.left?.file && block.right?.file ? '' : 'pair-single'}`}>
              {[block.left, block.right].map((img: any) =>
                img?.file ? (
                  <figure class="image-block pair-item">
                    <img src={img.file} alt={img.alt} loading="lazy" />
                    {img.caption && <figcaption set:html={renderInline(img.caption)} />}
                  </figure>
                ) : null,
              )}
            </div>
          ) : null
        ) : block.file ? (
          <figure class={`image-block iw-${block.width || 'full'} ia-${block.align || 'center'}`}>
            <img src={block.file} alt={block.alt} loading="lazy" />
            {block.caption && <figcaption set:html={renderInline(block.caption)} />}
          </figure>
        ) : null,
      )
    }

    <div class="source-note">{home.sourceNote}</div>

    <div class="links-row">
      {
        home.links.map((link: any) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .inner {
    position: relative;
    z-index: 5;
    max-width: 680px;
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
  }

  .text-block {
    font-size: 15px;
    line-height: 1.85;
    color: rgba(224, 219, 212, 0.68);
    text-wrap: pretty;
  }

  .text-block + .text-block {
    margin-top: 1.6rem;
  }

  .text-block.ts-large {
    font-size: 17px;
    line-height: 1.8;
  }

  .text-block.ts-small {
    font-size: 13px;
    line-height: 1.8;
  }

  .image-block {
    margin: 2.8rem 0;
    border: 1px solid rgba(224, 219, 212, 0.14);
    padding: 6px;
    background: rgba(20, 17, 25, 0.5);
  }

  .image-block img {
    width: 100%;
    display: block;
    filter: saturate(0.55) brightness(0.9);
  }

  .image-block figcaption {
    font-size: 10px;
    letter-spacing: 0.05em;
    color: rgba(224, 219, 212, 0.32);
    padding: 0.45rem 0.3rem 0.2rem;
  }

  .image-block.iw-medium {
    width: 66%;
  }

  .image-block.iw-small {
    width: 45%;
  }

  .image-block.ia-center {
    margin-left: auto;
    margin-right: auto;
  }

  .image-block.ia-right {
    margin-left: auto;
  }

  .image-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    align-items: start;
    margin: 2.8rem 0;
  }

  .image-pair .image-block.pair-item {
    margin: 0;
  }

  .image-pair.pair-single {
    grid-template-columns: 1fr;
    width: 66%;
    margin-left: auto;
    margin-right: auto;
  }

  .source-note {
    font-size: 12px;
    line-height: 1.7;
    color: rgba(224, 219, 212, 0.38);
    margin-top: 2.5rem;
    font-style: italic;
  }

  .links-row {
    margin-top: 3.2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .links-row a {
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #48c6a8;
    text-decoration: none;
  }

  .links-row a:hover {
    color: #e0dbd4;
  }

  .links-row a:nth-child(2) {
    color: rgba(224, 219, 212, 0.55);
  }

  .links-row a:nth-child(2):hover {
    color: #48c6a8;
  }

  @media (max-width: 680px) {
    .inner {
      padding: 0 1rem 4rem;
    }
    /* keep deliberately-small images legible on phone-width columns */
    .image-block.iw-small {
      width: 62%;
    }
    .image-block.iw-medium {
      width: 80%;
    }
    .image-pair {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }
    .image-pair.pair-single {
      width: 100%;
    }
  }
</style>
