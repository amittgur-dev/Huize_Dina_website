---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildTimeline } from '../lib/timelines';
import type { RawTimeline } from '../lib/timelines';

// One file per timeline (content/timelines/*.json) so the CMS can offer
// them as 3 separate, reorderable-within-themselves entries. Display order
// always follows the episode number, independent of file/CMS list order.
const timelineFiles = import.meta.glob<RawTimeline>('../../content/timelines/*.json', { eager: true, import: 'default' });
const ROMAN_ORDER: Record<string, number> = { I: 1, II: 2, III: 3, IV: 4, V: 5 };
const timelinesRaw = Object.values(timelineFiles).sort(
  (a, b) => (ROMAN_ORDER[a.episode] ?? 99) - (ROMAN_ORDER[b.episode] ?? 99),
);

const timelines = timelinesRaw.map(buildTimeline);
const SLUGS = timelines.map((t) => t.slug);
---

<BaseLayout title="Timelines" active="timelines" description="Three life stories from the Huize Dina archive, told episode by episode.">

  <section class="pa-hero">
    <div class="pa-hero-title" id="hero-title">{timelines[0].title}</div>
    <div class="hero-years" id="hero-years">{timelines[0].years}</div>

    <div class="sis-row" id="sis-row" hidden={timelines[0].slug !== 'engers'}>
      <span class="sis-label">Two sisters, one file —</span>
      <button type="button" class="sis-btn" data-jump="mina">Mina</button>
      <button type="button" class="sis-btn" data-jump="sara">Sara</button>
    </div>

    <div class="tabs-row" role="tablist">
      {
        timelines.map((tl, i) => (
          <button type="button" class={`tl-tab ${i === 0 ? 'is-active' : ''}`} data-idx={i} data-slug={tl.slug} role="tab" aria-selected={i === 0}>
            <span class="tab-num">Episode {tl.episode}</span>
            <span class="tab-name">{tl.name}</span>
            <span class="tab-years">{tl.years}</span>
          </button>
        ))
      }
    </div>
  </section>

  <div id="pa-inner">
    {
      timelines.map((tl, i) => (
        <div class="tl-panel" data-slug={tl.slug} data-yr-min={tl.yrMin} data-yr-max={tl.yrMax} data-total-h={tl.totalH} style={`height:${tl.totalH}px;`} hidden={i !== 0}>
          <div class="pa-spine" aria-hidden="true" />

          {tl.rulers.map((r) => (
            <div class="ruler" style={`top:${r.top}px;`}>
              <div class="ruler-inner">
                <div class="ruler-tick" />
                <div class="ruler-year">{r.year}</div>
              </div>
            </div>
          ))}

          {tl.events.map((ev) => (
            <div class="nd" data-ev-idx={ev.idx} style={`top:${ev.top}px;`}>
              <div class="pa-nd-dot">
                <div class="dot" />
                <div class="nd-date">{ev.date}</div>
              </div>

              <div
                class={`cd ${ev.isLeft ? 'cdl' : 'cdr'}`}
                style={`transform:translate3d(${ev.isLeft ? 14 : -14}px,0,0) scale(0.86);`}
              >
                <div class="pa-conn" aria-hidden="true" />
                <div class="cd-border">
                  <div class="ci">
                    {ev.tag && <div class="ev-tag">{ev.tagLabel}</div>}
                    <div class="ev-eyebrow">{ev.heading}</div>
                    <div class="ev-text">{ev.text}</div>
                    {ev.image && (
                      <div class="ph-wrap">
                        <img
                          class={`ev-img img-${ev.image.variant}`}
                          src={ev.image.src}
                          alt={ev.image.caption}
                          loading="lazy"
                          data-full-src={ev.image.src}
                          data-caption={ev.image.caption}
                          style={
                            ev.image.variant === 'zoom'
                              ? `object-position:${ev.image.focus};transform:scale(${ev.image.zoom});transform-origin:${ev.image.focus};`
                              : undefined
                          }
                        />
                        <div class="ev-img-caption">{ev.image.caption}</div>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      ))
    }
  </div>

  <div id="lightbox" class="lightbox" hidden>
    <img id="lightbox-img" src="" alt="" />
    <div id="lightbox-cap" class="lightbox-cap"></div>
    <div class="lightbox-hint">Click anywhere to close</div>
  </div>

  <div id="yr-gauge" class="yr-gauge">{timelines[0].yrMin}</div>

  <script
    type="application/json"
    id="hero-title-data"
    set:html={JSON.stringify(Object.fromEntries(timelines.map((t) => [t.slug, t.title])))}
  />
</BaseLayout>

<style>
  .pa-hero {
    position: relative;
    z-index: 6;
    text-align: center;
    padding: 9rem 1rem 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    margin-bottom: 2.5rem;
  }

  .pa-hero-title {
    font-size: 2.2rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: rgba(224, 219, 212, 0.92);
    text-wrap: pretty;
  }

  .hero-years {
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(224, 219, 212, 0.32);
    margin-bottom: 2.2rem;
    margin-top: 2px;
  }

  .sis-row {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 1.1rem;
    margin-top: -1.6rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .sis-row[hidden] {
    display: none;
  }

  .sis-label {
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(224, 219, 212, 0.4);
  }

  .sis-btn {
    font-family: inherit;
    font-size: 14px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: none;
    border: none;
    border-bottom: 1px solid rgba(72, 198, 168, 0.55);
    padding: 0 0 3px;
    cursor: pointer;
    color: #48c6a8;
  }

  .tabs-row {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 0.75rem;
    flex-wrap: nowrap;
    max-width: 760px;
    margin: 0 auto;
  }

  .tl-tab {
    font-family: inherit;
    cursor: pointer;
    text-align: center;
    padding: 0.85rem 1rem;
    border-radius: 2px;
    flex: 1 1 0;
    min-width: 0;
    background: rgba(20, 17, 25, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.13);
    color: rgba(224, 219, 212, 0.55);
    letter-spacing: 0.05em;
    transition: border-color 120ms ease-out, color 120ms ease-out, background 120ms ease-out;
  }

  .tl-tab.is-active {
    background: rgba(72, 198, 168, 0.07);
    border-color: rgba(72, 198, 168, 0.55);
    color: #48c6a8;
  }

  .tab-num {
    font-size: 11px;
    letter-spacing: 0.26em;
    display: block;
    opacity: 0.65;
  }

  .tab-name {
    font-size: 16px;
    letter-spacing: 0.04em;
    display: block;
    margin-top: 6px;
    white-space: nowrap;
  }

  .tab-years {
    font-size: 13px;
    letter-spacing: 0.12em;
    display: block;
    margin-top: 5px;
    opacity: 0.55;
  }

  #pa-inner {
    position: relative;
    z-index: 5;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .tl-panel {
    position: relative;
  }

  .pa-spine {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.18);
  }

  .ruler {
    position: absolute;
    left: 0;
    right: 0;
  }

  .ruler-inner {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ruler-tick {
    width: 28px;
    height: 1px;
    background: rgba(255, 255, 255, 0.09);
  }

  .ruler-year {
    font-size: 13px;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.34);
    font-family: 'JetBrains Mono', monospace;
    margin-top: 5px;
  }

  .nd {
    position: absolute;
    left: 0;
    right: 0;
  }

  .pa-nd-dot {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    z-index: 2;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid rgba(72, 198, 168, 0.75);
    background: rgba(72, 198, 168, 0.12);
  }

  .nd-date {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: rgba(58, 168, 190, 0.8);
    font-family: 'JetBrains Mono', monospace;
    white-space: nowrap;
  }

  .cd {
    position: absolute;
    top: 30px;
    opacity: 0;
    will-change: opacity, transform;
    transition: opacity 550ms cubic-bezier(0.22, 0.61, 0.36, 1), transform 550ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .cd.revealed {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1) !important;
  }

  .cdl {
    right: calc(50% + 112px);
    transform-origin: right center;
  }

  .cdr {
    left: calc(50% + 112px);
    transform-origin: left center;
  }

  .pa-conn {
    position: absolute;
    top: -26px;
    height: 1px;
    width: 112px;
  }

  .cdl .pa-conn {
    right: -112px;
    background: linear-gradient(to left, transparent, rgba(72, 198, 168, 0.55));
  }

  .cdr .pa-conn {
    left: -112px;
    background: linear-gradient(to right, transparent, rgba(72, 198, 168, 0.55));
  }

  .cd-border {
    padding: 1px;
    border-radius: 3px;
    background:
      linear-gradient(145deg, rgba(72, 198, 168, 0.84) 0%, rgba(72, 198, 168, 0) 48%),
      linear-gradient(325deg, #09443b 0%, #1c8470 52%, #48c6a8 100%);
  }

  .ci {
    background: rgba(20, 17, 25, 0.97);
    border-radius: 2px;
    padding: 1.1rem 1.3rem;
    width: 410px;
    max-width: calc(50vw - 150px);
    transition: box-shadow 600ms ease-out;
  }

  .ev-tag {
    font-size: 11.5px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    color: rgba(224, 219, 212, 0.42);
  }

  .ev-eyebrow {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
    color: #48c6a8;
  }

  .ev-text {
    font-size: 15px;
    color: rgba(224, 219, 212, 0.82);
    line-height: 1.8;
    text-wrap: pretty;
  }

  .ph-wrap {
    margin-top: 1rem;
    border: 1px solid rgba(224, 219, 212, 0.12);
    overflow: hidden;
    background: rgba(0, 0, 0, 0.25);
  }

  .ev-img {
    cursor: zoom-in;
  }

  .img-default {
    max-width: 100%;
    max-height: 420px;
    width: auto;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .img-full {
    max-width: 100%;
    display: block;
  }

  .img-zoom {
    width: 100%;
    display: block;
    height: 320px;
    object-fit: cover;
  }

  .ev-img-caption {
    font-size: 12px;
    letter-spacing: 0.05em;
    color: rgba(224, 219, 212, 0.62);
    padding: 0.5rem 0.65rem;
    font-style: italic;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgba(20, 17, 25, 0.95);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    cursor: zoom-out;
    padding: 2.5rem;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox img {
    max-width: 92vw;
    max-height: 80vh;
    border: 1px solid rgba(224, 219, 212, 0.22);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.6);
  }

  .lightbox-cap {
    font-size: 14px;
    letter-spacing: 0.08em;
    color: rgba(224, 219, 212, 0.65);
    text-align: center;
    max-width: 720px;
    font-style: italic;
  }

  .lightbox-hint {
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(72, 198, 168, 0.45);
  }

  .yr-gauge {
    position: fixed;
    bottom: 1.8rem;
    right: 1.8rem;
    z-index: 15;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.24em;
    color: rgba(72, 198, 168, 0.4);
  }

  /* 900px, not the more typical ~680px: below this, the desktop two-column
     layout's cards get squeezed narrower than the width the build-time
     height estimate (src/lib/timelines.ts's estimateHeight) assumes, so
     text wraps to more lines than accounted for and cards can overlap —
     confirmed empirically (fails at 700px, clean from 750px up; 900px
     keeps a safety margin above that for future content edits). */
  @media (max-width: 900px) {
    .pa-hero {
      padding-top: 8rem;
      padding-bottom: 1.5rem;
    }
    .pa-hero-title {
      font-size: 1.5rem;
    }
    .tabs-row {
      gap: 0.4rem;
    }
    .tl-tab {
      padding: 0.6rem 0.4rem;
    }
    .tab-num {
      font-size: 9.5px;
    }
    .tab-name {
      font-size: 12px;
      white-space: normal;
      line-height: 1.25;
    }
    .tab-years {
      font-size: 10.5px;
    }
    #pa-inner {
      padding: 0 4px 0 0;
    }
    .pa-spine {
      left: 28px;
      transform: none;
    }
    .pa-nd-dot {
      left: 28px;
      transform: translateX(0);
      /* Desktop centers this whole box on the spine (left:50% +
         translateX(-50%)), so align-items:center naturally lands both the
         dot and the date on it. Mobile instead anchors the box's own LEFT
         edge to the spine (so the date text can extend rightward without
         overflowing off the narrow viewport on the left) — but that makes
         center-alignment center everything on the *date text's* width
         instead, pulling the dot off the spine to the right. flex-start
         keeps the date attached at the spine's x-position; the dot then
         gets pulled back onto the spine explicitly below. */
      align-items: flex-start;
    }
    .dot {
      /* Pulls the (10px-wide) dot's center back onto the spine at x=28,
         since flex-start above left-aligns it flush with the spine
         instead of centered on it. */
      margin-left: -5px;
    }
    .nd-date {
      font-size: 13px;
    }
    .pa-conn {
      display: none;
    }

    /* Desktop lays cards out with pre-computed pixel `top` offsets tuned for
       two independent left/right columns. On a single mobile column that
       same vertical rhythm is too tight and cards overlap, so mobile drops
       absolute positioning for `.nd`/`.cd` and lets each event flow
       naturally instead (height driven by real rendered content). */
    .tl-panel {
      height: auto !important;
    }
    .nd {
      position: relative !important;
      top: auto !important;
      /* Establishes a new block formatting context so .cd's margin-top
         below can't collapse through .nd and escape upward — without
         this, .cd renders flush with .nd's top (margin collapsing),
         landing exactly on top of the absolutely-positioned .pa-nd-dot. */
      display: flow-root;
      margin-bottom: 1.8rem;
    }
    .cdl,
    .cdr {
      position: relative;
      top: auto;
      right: auto;
      left: auto;
      margin-top: 42px;
      /* margin (not `left`) does the shift: with position:relative, `left`
         offsets the box from its normal-flow position without shrinking
         its auto-computed width, so the box (and its gradient background)
         overflowed the viewport on the right by exactly that offset.
         margin-left is subtracted from the auto-width itself, so the box
         and its .ci child both end up correctly sized within it. */
      margin-left: 50px;
      margin-right: 24px;
    }
    .ci {
      width: auto;
      max-width: none;
      box-sizing: border-box;
    }
    /* The floating current-year indicator is a desktop aid for the wide
       two-column layout; on the single mobile column each event's own
       date is already always attached above its box, so the gauge is
       redundant and — being fixed to the viewport corner — ends up
       sitting on top of whatever image happens to scroll underneath it. */
    .yr-gauge {
      display: none;
    }
  }
</style>

<script>
  const SLUGS = ['dejong', 'engers', 'swaab'];

  const heroTitle = document.getElementById('hero-title')!;
  const heroYears = document.getElementById('hero-years')!;
  const sisRow = document.getElementById('sis-row')!;
  const gauge = document.getElementById('yr-gauge')!;
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tl-tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.tl-panel'));

  const TITLES: Record<string, { title: string; years: string }> = {};
  panels.forEach((p) => {
    const slug = p.dataset.slug!;
    const titleEl = document.querySelector(`.tl-tab[data-slug="${slug}"] .tab-name`);
    TITLES[slug] = { title: titleEl?.textContent || '', years: p.dataset.yrMin + '—' + p.dataset.yrMax };
  });
  // Prefer the real title strings (not just names) baked in at build time.
  const HERO_TITLES: Record<string, string> = JSON.parse(
    document.getElementById('hero-title-data')?.textContent || '{}',
  );

  let active = 0;

  function activateFromHash(): number {
    const h = (location.hash || '').replace('#', '');
    const idx = SLUGS.indexOf(h);
    return idx >= 0 ? idx : 0;
  }

  function setActive(idx: number, opts: { fromHash?: boolean; scroll?: boolean } = {}) {
    active = idx;
    const slug = SLUGS[idx];

    panels.forEach((p) => {
      p.hidden = p.dataset.slug !== slug;
    });
    tabs.forEach((t) => {
      const on = t.dataset.slug === slug;
      t.classList.toggle('is-active', on);
      t.setAttribute('aria-selected', String(on));
    });

    heroTitle.textContent = HERO_TITLES[slug] || TITLES[slug]?.title || '';
    heroYears.textContent = TITLES[slug]?.years || '';
    sisRow.hidden = slug !== 'engers';

    if (!opts.fromHash) {
      try {
        history.replaceState(null, '', '#' + slug);
      } catch {
        /* ignore */
      }
    }
    if (opts.scroll) window.scrollTo(0, 0);

    updateGauge();
    observeActivePanel();
  }

  tabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.dataset.idx);
      if (idx !== active) setActive(idx, { scroll: true });
    });
  });

  window.addEventListener('hashchange', () => {
    const idx = activateFromHash();
    if (idx !== active) setActive(idx, { fromHash: true });
  });

  // --- Sister jump (Engers) ---
  document.querySelectorAll<HTMLButtonElement>('.sis-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.jump as 'mina' | 'sara';
      const panel = panels.find((p) => p.dataset.slug === 'engers');
      if (!panel) return;
      const targets = Array.from(panel.querySelectorAll<HTMLElement>('.nd')).filter((nd) => {
        const cd = nd.querySelector('.ci .ev-tag');
        return cd && cd.textContent === (tag === 'mina' ? 'Mina' : 'Sara');
      });
      const el = targets[0];
      if (!el) return;
      const top = el.getBoundingClientRect().top + window.scrollY - window.innerHeight * 0.34;
      window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      const ci = el.querySelector<HTMLElement>('.ci');
      if (ci) {
        ci.style.boxShadow = '0 0 0 2px rgba(72,198,168,0.75)';
        setTimeout(() => {
          ci.style.boxShadow = 'none';
        }, 1100);
      }
    });
  });

  // --- Reveal on scroll ---
  let io: IntersectionObserver | null = null;
  function observeActivePanel() {
    if (io) io.disconnect();
    const panel = panels[active];
    io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle('revealed', entry.isIntersecting);
        });
      },
      { rootMargin: '-38% 0px -10% 0px', threshold: 0 },
    );
    panel.querySelectorAll('.cd').forEach((el) => io!.observe(el));
  }

  // --- Year gauge ---
  function updateGauge() {
    const panel = panels[active];
    const y0 = Number(panel.dataset.yrMin);
    const y1 = Number(panel.dataset.yrMax);
    const totalH = Number(panel.dataset.totalH) || 8000;
    const scroll = window.scrollY;
    const yr = Math.round(y0 + (Math.max(0, scroll - 200) / Math.max(1, totalH - 200)) * (y1 - y0));
    gauge.textContent = String(Math.max(y0, Math.min(y1, yr)));
  }
  window.addEventListener('scroll', updateGauge, { passive: true });

  // --- Lightbox ---
  const lightbox = document.getElementById('lightbox')!;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxCap = document.getElementById('lightbox-cap')!;

  document.querySelectorAll<HTMLImageElement>('.ev-img').forEach((img) => {
    img.addEventListener('click', () => {
      lightboxImg.src = img.dataset.fullSrc || img.src;
      lightboxImg.alt = img.alt;
      lightboxCap.textContent = img.dataset.caption || '';
      lightbox.hidden = false;
    });
  });
  lightbox.addEventListener('click', () => {
    lightbox.hidden = true;
    lightboxImg.src = '';
  });

  // --- Init ---
  setActive(activateFromHash(), { fromHash: true });
</script>
