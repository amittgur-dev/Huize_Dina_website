---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { renderInline } from '../lib/markup';
import team from '../../content/team.json';
---

<BaseLayout title="Team" active="team">
  <Hero title={team.title} eyebrow={team.eyebrow} compact />

  <div class="inner">
    {
      team.members.map((member: any) => (
        <div class="row">
          <div class="photo">
            <img src={`/${member.photo}`} alt={member.name} loading="lazy" />
          </div>
          <div>
            <div class="name">{member.name}</div>
            <div class="role">{member.role}</div>
            <div class="bio" set:html={renderInline(member.bio)} />
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>

<style>
  .inner {
    position: relative;
    z-index: 5;
    max-width: 860px;
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
    display: flex;
    flex-direction: column;
  }

  .row {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 2.2rem;
    padding: 2.2rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    align-items: start;
  }

  .row:last-child {
    border-bottom: none;
  }

  .photo {
    border: 1px solid rgba(224, 219, 212, 0.14);
    padding: 6px;
    background: rgba(20, 17, 25, 0.5);
  }

  .photo img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    filter: saturate(0.95) brightness(0.97);
  }

  .name {
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    color: rgba(224, 219, 212, 0.92);
  }

  .role {
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(72, 198, 168, 0.72);
    margin: 0.45rem 0 0.9rem;
    line-height: 1.7;
  }

  .bio {
    font-size: 14px;
    line-height: 1.7;
    color: rgba(224, 219, 212, 0.62);
    text-wrap: pretty;
  }

  @media (max-width: 680px) {
    .inner {
      padding: 0 1rem 4rem;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 1.1rem;
    }
    .photo {
      width: 150px;
    }
  }
</style>
