---
import Masthead from '../components/Masthead.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  active?: string;
  fullscreen?: boolean;
  // For the landing page: no masthead/nav at all, per its design.
  hideMasthead?: boolean;
}

const {
  title,
  description = "Polyphonic Archive — a podcast about the girls of Huize Dina, a Jewish girls' home in Santpoort, 1920s–40s.",
  active = '',
  fullscreen = false,
  hideMasthead = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Huize Dina</title>
  </head>
  <body>
    <div class:list={['page-root', { fullscreen }]}>
      {
        !fullscreen && (
          <>
            <div class="bg-vignette" aria-hidden="true" />
            <div class="bg-noise" aria-hidden="true" />
          </>
        )
      }
      <slot name="bg-extra" />

      {
        !hideMasthead && (
          <Masthead active={active}>
            <slot name="header-extra" slot="extra" />
          </Masthead>
        )
      }

      <slot />
    </div>

    <!-- Netlify Identity's invite/recovery/confirmation emails link to the
         site root, not to /admin — this widget needs to be present wherever
         that link lands so it can pick up the #token in the URL and show
         the "set your password" dialog, then hand the editor off to the
         CMS. -->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script is:inline>
      // The widget fires 'login' both for a fresh invite/recovery/
      // confirmation completion AND for silently restoring an already-
      // logged-in session on any later page load — only the former should
      // send someone to the CMS, or every visit while logged in would
      // hijack normal site browsing. Only redirect when this page load's
      // URL actually carries one of those one-time tokens.
      if (window.netlifyIdentity && /(invite_token|recovery_token|confirmation_token|email_change_token)=/.test(window.location.hash)) {
        window.netlifyIdentity.on('login', () => {
          document.location.href = '/admin/';
        });
      }
    </script>
  </body>
</html>

<style>
  .page-root {
    position: relative;
    min-height: 100vh;
    background: #2c2830;
    color: #e0dbd4;
    font-family: 'Courier Prime', 'Courier New', Courier, monospace;
    overflow-x: hidden;
  }

  .page-root.fullscreen {
    height: 100vh;
    min-height: 0;
    overflow: hidden;
  }

  .bg-vignette {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(ellipse at 50% 40%, transparent 52%, rgba(0, 0, 0, 0.13) 100%);
  }

  .bg-noise {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0.04;
    mix-blend-mode: overlay;
    background-image: url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22220%22 height=%22220%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%222%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');
  }
</style>
