---
export interface Props {
  title: string;
  eyebrow?: string;
  compact?: boolean;
}
const { title, eyebrow, compact = false } = Astro.props;
---

<div class:list={['hero', { compact }]}>
  <div class="hero-title">{title}</div>
  {eyebrow && <div class="hero-eyebrow">{eyebrow}</div>}
</div>

<style>
  .hero {
    position: relative;
    z-index: 5;
    text-align: center;
    padding: 9.5rem 1rem 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    margin-bottom: 3rem;
  }

  .hero.compact {
    padding: 8.5rem 1rem 3rem;
    margin-bottom: 2.5rem;
  }

  .hero-title {
    font-size: 2.2rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: rgba(224, 219, 212, 0.92);
    text-wrap: pretty;
  }

  .hero.compact .hero-title {
    font-size: 2rem;
  }

  .hero-eyebrow {
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(224, 219, 212, 0.32);
    margin-top: 0.6rem;
  }

  @media (max-width: 680px) {
    .hero {
      padding-top: 8rem;
      padding-bottom: 2rem;
    }
    .hero-title {
      font-size: 1.6rem;
    }
  }
</style>
