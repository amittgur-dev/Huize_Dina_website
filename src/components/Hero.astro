---
export interface Props {
  title: string;
  eyebrow?: string;
  compact?: boolean;
  // The page title already appears as the active link in the masthead nav —
  // repeating it verbatim as a giant heading right below is redundant on
  // pages where it doesn't add anything (Podcast/Team/Contact just restate
  // the nav label). Set this to keep the title as a real (but visually
  // hidden) heading for accessibility/SEO, while the eyebrow line — styled
  // up to carry the visual weight — becomes what's actually shown.
  hideTitle?: boolean;
}
const { title, eyebrow, compact = false, hideTitle = false } = Astro.props;
---

<div class:list={['hero', { compact, 'title-hidden': hideTitle }]}>
  <h1 class:list={['hero-title', { 'sr-only': hideTitle }]}>{title}</h1>
  {eyebrow && <div class="hero-eyebrow">{eyebrow}</div>}
</div>

<style>
  .hero {
    position: relative;
    z-index: 5;
    text-align: center;
    padding: 9.5rem 1rem 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    margin-bottom: 3rem;
  }

  .hero.compact {
    padding: 8.5rem 1rem 3rem;
    margin-bottom: 2.5rem;
  }

  .hero-title {
    margin: 0;
    font-size: 2.2rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: rgba(224, 219, 212, 0.92);
    text-wrap: pretty;
  }

  .hero.compact .hero-title {
    font-size: 2rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero-eyebrow {
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(224, 219, 212, 0.32);
    margin-top: 0.6rem;
  }

  /* With the title hidden, the eyebrow is the only visible line — give it
     the visual weight the title used to carry instead of leaving the hero
     looking empty. */
  .title-hidden .hero-eyebrow {
    font-size: 15px;
    letter-spacing: 0.22em;
    color: rgba(224, 219, 212, 0.62);
    margin-top: 0;
  }

  @media (max-width: 680px) {
    .hero {
      padding-top: 8rem;
      padding-bottom: 2rem;
    }
    .hero-title {
      font-size: 1.6rem;
    }
  }
</style>
